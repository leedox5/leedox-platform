#!/usr/bin/env ruby

require "json"
require "optparse"

command = ARGV.shift || "readiness"
options = {}
OptionParser.new do |parser|
  parser.on("--artifact PATH") { |value| options[:artifact] = value }
  parser.on("--target PATH") { |value| options[:target] = value }
  parser.on("--expected-commit SHA") { |value| options[:expected_commit] = value }
end.parse!

require_relative "../config/environment"

def emit(payload)
  puts JSON.generate(payload)
end

begin
  case command
  when "readiness", "verify"
    emit(ChatdoxRelease::Readiness.call.to_h)
  when "install"
    required = %i[artifact target expected_commit]
    missing = required.reject { |key| options[key].present? }
    raise OptionParser::MissingArgument, missing.join(", ") if missing.any?

    result = ChatdoxRelease::Installer.call(
      artifact: options[:artifact], target: options[:target], expected_commit: options[:expected_commit],
      confirm: ENV["CONFIRM_PRODUCTION"] == "1"
    )
    emit(result.to_h)
  when "rollback-legacy"
    unless ENV["CONFIRM_PRODUCTION"] == "1" && ENV["CHATDOX_CONTENT_SOURCE"] == "legacy"
      raise ContentSnapshot::Error.new(:confirmation_required, "Set CONFIRM_PRODUCTION=1 and CHATDOX_CONTENT_SOURCE=legacy")
    end
    emit(status: "legacy_confirmed")
  else
    raise OptionParser::InvalidArgument, "unknown command: #{command}"
  end
rescue ContentSnapshot::Error, OptionParser::ParseError => error
  emit(status: "rejected", reason: error.respond_to?(:code) ? error.code : "invalid_arguments")
  exit 1
end
