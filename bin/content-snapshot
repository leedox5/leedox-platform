#!/usr/bin/env ruby

require "optparse"

options = {
  repository: Dir.pwd,
  source: "hq/chatdox",
  mode: :inspect
}

OptionParser.new do |parser|
  parser.banner = "Usage: bin/content-snapshot [--inspect | --build TARGET] [options]"
  parser.on("--inspect", "Validate the committed source without publishing") { options[:mode] = :inspect }
  parser.on("--build TARGET", "Atomically publish a validated snapshot") do |target|
    options[:mode] = :build
    options[:target] = target
  end
  parser.on("--repository PATH", "Git repository containing the HQ source") { |path| options[:repository] = path }
  parser.on("--source PATH", "Repository-relative product source path") { |path| options[:source] = path }
end.parse!

require_relative "../config/environment"

begin
  source = ContentSnapshot::GitSource.new(repository_root: options[:repository], source_path: options[:source])
  source.with_committed_tree do |root, commit|
    if options[:mode] == :inspect
      catalog = ProductContent::CatalogMetadataLoader.load(root:)
      puts "Source commit: #{commit}"
      puts "Catalog valid: #{catalog.valid?}"
      puts "Seasons: #{catalog.seasons.length}"
      catalog.diagnostics.each { |item| puts "#{item.severity}: #{item.code} at #{item.location}" }
      exit(catalog.valid? ? 0 : 1)
    end

    ContentSnapshot::Builder.new(source_root: root, source_commit: commit, target: options.fetch(:target)).build!
    puts "Snapshot published: #{Pathname.new(options[:target]).expand_path}"
    puts "Source commit: #{commit}"
  end
rescue ContentSnapshot::Error, KeyError => error
  warn "Snapshot rejected: #{error.message}"
  exit 1
end
