#!/usr/bin/env ruby

require "json"
require "net/http"
require "optparse"
require "uri"

options = { base_url: "http://127.0.0.1:3002" }
OptionParser.new do |parser|
  parser.on("--base-url URL") { |value| options[:base_url] = value }
end.parse!

begin
  base = URI(options[:base_url])
  unless %w[http https].include?(base.scheme) && base.host && [ "", "/" ].include?(base.path.to_s)
    warn JSON.generate(status: "rejected", reason: "invalid_base_url")
    exit 1
  end

def request(base, path)
  uri = base.dup
  uri.path = path
  uri.query = nil
  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 5, read_timeout: 15) do |http|
    http.request(Net::HTTP::Get.new(uri.request_uri))
  end
end

checks = {
  "/" => 200, "/pricing" => 200, "/chatdox" => 200, "/chatdox/s01" => 200,
  "/chatdox/s01/01" => 200, "/chatdox/s02" => 200, "/docs" => 200, "/docs/01" => 200,
  "/chatdox/s01/1" => 404
}
results = checks.map do |path, expected|
  response = request(base, path)
  { kind: "route", path:, status: response.code.to_i, content_type: response["content-type"], pass: response.code.to_i == expected }
end

page = request(base, "/chatdox")
assets = page.body.scan(%r{(?:href|src)="(/assets/[^"?]+\.(?:css|js))"}).flatten.uniq.sort
assets.each do |path|
  response = request(base, path)
  expected_type = path.end_with?(".css") ? "text/css" : "javascript"
  content_type = response["content-type"].to_s
  results << {
    kind: "asset", path:, status: response.code.to_i, content_type:,
    pass: response.code.to_i == 200 && content_type.include?(expected_type)
  }
end

  passed = assets.any? && results.all? { |item| item[:pass] }
  puts JSON.generate(status: passed ? "passed" : "failed", asset_count: assets.length, checks: results)
  exit(passed ? 0 : 1)
rescue StandardError => error
  warn JSON.generate(status: "failed", reason: "request_error", error: error.class.name)
  exit 1
end
