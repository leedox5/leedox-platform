<%# locals: (hub:) %>
<section id="seasons" class="bg-white py-12 sm:py-16">
  <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
    <header class="max-w-3xl">
      <p class="text-xs font-bold uppercase text-blue-700">Build → Operate &amp; Grow</p>
      <h2 class="mt-3 text-3xl font-extrabold text-slate-950">하나의 상품, 이어지는 두 시즌</h2>
      <p class="mt-4 break-normal leading-7 text-slate-600 sm:break-keep">S01의 구축과 출시가 끝이 아니라 S02의 운영과 성장으로 이어집니다. 기존 CHATDOX 라이선스로 두 시즌을 함께 이용합니다.</p>
    </header>

    <% if current_user %>
      <section aria-label="CHATDOX 전체 진도" class="mt-8 border-y border-slate-200 py-5">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold text-slate-700">CHATDOX 전체 진도</h3>
            <p class="mt-1 text-xs text-slate-500">현재 공개된 모든 시즌 기준</p>
            <p class="mt-2 text-lg font-bold text-slate-950">완료 <%= hub.summary.overall.completed_count %> / 공개 <%= hub.summary.overall.available_count %></p>
          </div>
          <strong class="text-2xl text-blue-700"><%= hub.summary.overall.percentage %>%</strong>
        </div>
      </section>
    <% end %>

    <div class="mt-9 grid gap-6 lg:grid-cols-2">
      <% hub.seasons.each do |season| %>
        <article id="season-<%= season.code %>" class="border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <div class="flex items-start justify-between gap-4">
            <p class="text-sm font-bold uppercase text-blue-700"><%= season.code.upcase %></p>
            <span class="border border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-700"><%= season.status_label %></span>
          </div>
          <h3 class="mt-5 text-2xl font-bold text-slate-950"><%= season.title %></h3>
          <p class="mt-3 min-h-20 break-normal text-sm leading-6 text-slate-600 sm:break-keep"><%= season.description %></p>
          <p class="mt-4 text-sm font-semibold text-slate-700">공개 <%= season.public_count %>편</p>

          <% if current_user && season.progress&.available? %>
            <div class="mt-4 border-t border-slate-200 pt-4">
              <p class="text-xs font-semibold text-slate-500">이 시즌 진도</p>
              <p class="mt-1 font-bold text-slate-900">완료 <%= season.progress.completed_count %> / 공개 <%= season.progress.available_count %> · <%= season.progress.percentage %>%</p>
            </div>
          <% elsif season.public_count.zero? %>
            <p class="mt-4 border-t border-slate-200 pt-4 text-sm text-slate-600">공개된 에피소드가 아직 없습니다.</p>
          <% end %>

          <% if season.cta_path %>
            <%= link_to season.cta_label, season.cta_path, class: "mt-6 inline-flex min-h-11 items-center justify-center bg-blue-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-blue-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" %>
          <% else %>
            <span class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-slate-500"><%= season.cta_label %></span>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>
