<%# Handoff 0081/0082 -- one product's license record on my page (MypageController::LicenseCard): the representative
    status and its period line, and -- in the 시리즈 section only -- the other records folded into "지난 기록 N건" (the
    controller leaves `past` empty for 이전 상품).
    Handoff 0085 R2 -- a one-line record in a divided list instead of a card (name · badge · period), and no
    콘텐츠 보기: this page is the account and payment record, the dashboard is where content is opened. %>
<% status_labels = { "active" => "이용 중", "scheduled" => "이용 예정", "expired" => "만료", "canceled" => "취소" } %>
<li class="py-4" data-license-card="<%= card.product.code %>">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <h4 class="min-w-0 break-words font-bold text-slate-900"><%= card.title %></h4>
    <%# HQ 0082 -- a long title wraps; the badge must not ("이용 / 중"). %>
    <span class="shrink-0 whitespace-nowrap rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-700"><%= status_labels.fetch(card.status) %></span>
    <% period = if card.status == "active" then dashboard_license_period_text(card.license)
       elsif card.status == "scheduled" then license_scheduled_period_text(card.license)
       else license_expired_period_text(card.license)
       end %>
    <p class="w-full text-sm text-slate-600 sm:ml-auto sm:w-auto"><%= period %></p>
  </div>
  <% if card.past.any? %>
    <details class="mt-2 text-sm">
      <summary class="cursor-pointer select-none font-semibold text-slate-500 hover:text-slate-700">지난 기록 <%= card.past.size %>건</summary>
      <ul class="mt-2 space-y-1 text-xs text-slate-500">
        <% card.past.each do |license| %>
          <li><%= license_span_text(license) %> · <%= status_labels.fetch(license.effective_status) %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</li>
