<%# Handoff 0081/0082 -- one product's license card on my page (MypageController::LicenseCard): the representative
    status and its period line, 콘텐츠 보기 while in use, and -- in the 시리즈 section only -- the other records folded
    into "지난 기록 N건" (the controller leaves `past` empty for 이전 상품). %>
<% status_labels = { "active" => "이용 중", "scheduled" => "이용 예정", "expired" => "만료", "canceled" => "취소" } %>
<article class="rounded-xl border border-slate-200 bg-slate-50 p-5" data-license-card="<%= card.product.code %>">
  <div class="flex items-center justify-between gap-3">
    <h4 class="min-w-0 break-words font-bold text-slate-900"><%= card.title %></h4>
    <%# HQ 0082 -- a long title wraps; the badge must not ("이용 / 중"). %>
    <span class="shrink-0 whitespace-nowrap rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-700"><%= status_labels.fetch(card.status) %></span>
  </div>
  <% period = if card.status == "active" then dashboard_license_period_text(card.license)
     elsif card.status == "scheduled" then license_scheduled_period_text(card.license)
     else license_expired_period_text(card.license)
     end %>
  <p class="mt-3 text-sm text-slate-600"><%= period %></p>
  <% if card.link %>
    <%= link_to "콘텐츠 보기", card.link, class: "mt-3 inline-block text-sm font-semibold text-blue-700 hover:underline" %>
  <% end %>
  <% if card.past.any? %>
    <details class="mt-3 text-sm">
      <summary class="cursor-pointer select-none font-semibold text-slate-500 hover:text-slate-700">지난 기록 <%= card.past.size %>건</summary>
      <ul class="mt-2 space-y-1 text-xs text-slate-500">
        <% card.past.each do |license| %>
          <li><%= license_span_text(license) %> · <%= status_labels.fetch(license.effective_status) %></li>
        <% end %>
      </ul>
    </details>
  <% end %>
</article>
