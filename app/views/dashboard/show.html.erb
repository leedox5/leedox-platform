<% content_for :title, "대시보드 | LEEDOX" %>
<% content_for :color_scheme, "dark" %><%# Handoff 0100 -- a dark page (FrameThemeHelper#body_class) %>
<%# Handoff 0079 -- copy in the tone of the story-series site (no "학습/커리큘럼/스킬"), no internal notes, no product
    name repeated under a card title that already shows it, a product-page button on the not-yet-seen cards, and the
    common footer. Which products appear, and the owned/trial/expired judgments, are unchanged.
    Handoff 0080 -- the series in use come first (D-009); the empty box only when there's neither a series nor a
    standalone product in use; a standalone product whose license ran out reads 만료.
    Handoff 0084 (D-010) -- dark body like the home and the series pages (colors only; content unchanged), with the
    display serif for the page and section headings.
    Handoff 0085 R1 -- "what can I watch": the earlier products only while in use, under an 이전 상품 heading, and
    더 둘러보기 shows the series not in use (the /products card, at most four) instead of earlier products.
    Handoff 0086 -- the two trial banners (무료 체험 D-N / 기간이 끝났습니다 · 가격 보기 →) are gone with the pricing
    page; the trial rule itself is unchanged.
    Handoff 0089 -- simplified: no header block, one h1 "{이름}님이 이용 중인 콘텐츠", link cards, 다른 콘텐츠. %>
<% content_for :head do %>
  <%= render "shared/display_font" %>
<% end %>
<div class="min-h-screen bg-page text-ink">
  <%= render "shared/header" %>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <%# Handoff 0089 -- no header block (eyebrow, greeting, 이어서 보세요, my page link): the page opens on what's in use,
        under the one h1. Series cards are the /products card (the whole card links to the series), earlier products
        are small link cards (name, 이용 중, period) to their table of contents. Which cards appear is unchanged
        (0080/0085). %>
    <section aria-label="이용 중인 콘텐츠">
      <h1 class="mb-6 font-display text-2xl font-bold text-ink sm:text-3xl"><%= current_user.name %>님이 이용 중인 콘텐츠</h1>

      <% if @series_in_use.any? %>
        <section aria-label="이용 중인 가이드" class="mb-10">
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% @series_in_use.each do |line| %>
              <%# Handoff 0090 -- straight to the 에피소드 section (#episodes) when the page has one. %>
              <%= render "product_lines/list_card", line: line, state: nil, heading: :h3,
                path: product_line_path(line.slug, anchor: (ProductLinesHelper::SERIES_SECTION_IDS[:episodes] if @series_with_episode_section.include?(line.id))),
                published_count: @series_published_counts.fetch(line.id, 0), badge: dashboard_in_use_badge,
                period: dashboard_license_period_text(@series_licenses[line.id]), data: { series_card: line.slug } %>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @legacy_products.any? %>
        <h2 class="mb-4 font-display text-xl font-bold text-ink">이전 상품</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <% @legacy_products.each do |product| %>
            <%# The aria-label keeps the section the earlier tests and screen readers find by the product's name. %>
            <section aria-label="<%= product.name %> 현황">
              <%= link_to product_content_index_path(product.code), data: { legacy_card: product.code },
                class: "block rounded-xl border border-line/10 bg-card px-5 py-4 transition hover:border-accent-soft/60" do %>
                <span class="flex items-center justify-between gap-3">
                  <span class="min-w-0 break-words font-bold text-ink"><%= product.name %></span>
                  <span class="<%= dashboard_in_use_badge.last %>"><%= dashboard_in_use_badge.first %></span>
                </span>
                <span class="mt-1 block text-sm text-ink-2"><%= dashboard_license_period_text(@legacy_licenses[product.id]) %></span>
              <% end %>
            </section>
          <% end %>
        </div>
      <% elsif @series_in_use.none? %>
        <section aria-label="이용 중인 콘텐츠 없음" class="rounded-2xl border border-line/10 bg-card p-8 text-center">
          <p class="text-base font-semibold text-ink">아직 이용 중인 콘텐츠가 없습니다.</p>
          <% if @browse_series.any? %>
            <p class="mt-1 text-sm text-ink-2">아래에서 관심 있는 콘텐츠를 둘러보세요.</p>
          <% else %>
            <%= link_to "가이드 둘러보기 →", products_path, class: "mt-2 inline-block text-sm font-semibold text-accent-ink hover:text-accent-ink-hover" %>
          <% end %>
        </section>
      <% end %>
    </section>

    <% if @browse_series.any? %>
      <section aria-label="다른 콘텐츠" class="mt-12">
        <h2 class="mb-4 font-display text-xl font-bold text-ink">다른 콘텐츠</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <% @browse_series.each do |line| %>
            <%= render "product_lines/list_card", line: line, state: @browse_states[line.id],
              published_count: @browse_published_counts.fetch(line.id, 0), heading: :h3 %>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>

  <%= render "shared/footer" %>
</div>
