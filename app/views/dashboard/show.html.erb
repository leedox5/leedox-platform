<div class="min-h-screen bg-gray-50">
  <%= render "shared/header" %>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-blue-600">My Dashboard</p>
        <h1 class="mt-1 text-3xl font-bold text-gray-900">
          안녕하세요, <%= current_user.name %>님
        </h1>
        <p class="mt-2 text-gray-600">상품별 학습 현황을 확인하고 다음 챕터로 이어가세요.</p>
      </div>

      <%= link_to "결제·라이선스 내역은 마이페이지에서 →",
        mypage_path,
        class: "text-sm font-semibold text-blue-600 hover:text-blue-700" %>
    </header>

    <% if current_user.trial_active? && @has_unowned_product %>
      <p class="mb-6 rounded-lg border border-violet-100 bg-violet-50 px-4 py-3 text-sm font-semibold text-violet-700">
        무료 체험 D-<%= current_user.trial_days_remaining %> · <%= I18n.l(current_user.trial_ends_on, locale: :ko, format: :long) %>까지 — 체험 기간에는 상품별로 더 많은 챕터가 열립니다. 기간이 끝나면 비로그인 방문자와 같은 범위로 돌아갑니다.
      </p>
    <% elsif current_user.trial_recently_expired? && @has_unowned_product %>
      <p class="mb-6 rounded-lg border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800">
        무료 체험 기간이 끝났습니다. 지금은 비로그인 방문자와 같은 범위까지 열려 있습니다. 이어서 읽으려면 라이선스를 확인해보세요.
        <%= link_to "가격 보기 →", pricing_path, class: "underline decoration-amber-400 underline-offset-2 hover:text-amber-900" %>
      </p>
    <% end %>

    <% if @owned_dashboards.any? %>
      <div class="space-y-6">
        <% @owned_dashboards.each do |pd| %>
          <% product = pd[:product] %>
          <section aria-label="<%= product.name %> 현황" class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-bold text-gray-900"><%= product.name %></h2>
              <%= product_status_badge(current_user, product) %>
            </div>
            <p class="mt-1 text-sm text-gray-600"><%= product_period_text(current_user, product) %></p>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="rounded-lg bg-gray-50 p-4">
                <p class="text-sm font-semibold text-gray-500">접근 가능 문서</p>
                <p class="mt-1 text-2xl font-bold text-gray-900"><%= pd[:accessible] %>/<%= pd[:total] %></p>
                <p class="mt-1 text-xs text-gray-500">실제 문서 접근은 계정 권한에 따라 매번 확인됩니다.</p>
              </div>

              <div class="rounded-lg bg-gray-50 p-4">
                <div class="flex items-center justify-between">
                  <p class="text-sm font-semibold text-gray-500">학습 진도</p>
                  <strong class="text-lg text-blue-600"><%= pd[:progress_percent] %>%</strong>
                </div>
                <p class="mt-1 text-xs text-gray-500">전체 <%= pd[:total] %>개 중 <%= pd[:completed_count] %>개 완료</p>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-gray-200"
                     role="progressbar"
                     aria-label="<%= product.name %> 학습 진도"
                     aria-valuenow="<%= pd[:progress_percent] %>"
                     aria-valuemin="0"
                     aria-valuemax="100">
                  <div class="h-full rounded-full bg-blue-600 transition-all" style="width: <%= pd[:progress_percent] %>%"></div>
                </div>
              </div>
            </div>

            <div class="mt-6 grid gap-4 lg:grid-cols-3">
              <div class="rounded-lg border border-gray-100 p-5 lg:col-span-2">
                <div class="flex items-center justify-between gap-4">
                  <h3 class="font-semibold text-gray-900">최근 완료한 챕터</h3>
                  <%= link_to "전체 보기", product_content_index_path(product.code), class: "text-sm font-semibold text-blue-600 hover:text-blue-700" %>
                </div>

                <% if pd[:recent_chapters].any? %>
                  <ul class="mt-3 divide-y divide-gray-100">
                    <% pd[:recent_chapters].each do |chapter| %>
                      <li class="flex items-center justify-between gap-4 py-3">
                        <div class="min-w-0">
                          <p class="text-xs text-gray-500">Chapter <%= chapter[:id] %></p>
                          <p class="truncate text-sm font-medium text-gray-900"><%= chapter[:title] %></p>
                        </div>
                        <%= link_to "다시 보기",
                          product_chapter_path(product.code, chapter[:id]),
                          class: "shrink-0 text-sm font-semibold text-blue-600 hover:text-blue-700" %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <div class="mt-3 rounded-lg bg-gray-50 p-5 text-center">
                    <p class="text-sm text-gray-600">아직 완료한 챕터가 없습니다.</p>
                  </div>
                <% end %>
              </div>

              <aside class="rounded-lg bg-gray-900 p-5 text-white">
                <p class="text-xs font-semibold uppercase tracking-wide text-blue-300">Next Step</p>
                <% if pd[:next_chapter] %>
                  <h3 class="mt-2 text-lg font-bold"><%= pd[:next_chapter][:title] %></h3>
                  <p class="mt-1 text-xs text-gray-300">Chapter <%= pd[:next_chapter][:id] %></p>
                  <%= link_to (pd[:completed_count].zero? ? "첫 챕터 시작" : "이어서 학습"),
                    product_chapter_path(product.code, pd[:next_chapter][:id]),
                    class: "mt-4 block rounded-lg bg-white px-4 py-2 text-center text-sm font-semibold text-gray-900 transition hover:bg-gray-100" %>
                <% else %>
                  <h3 class="mt-2 text-lg font-bold">모든 챕터를 완료했습니다.</h3>
                  <p class="mt-1 text-xs text-gray-300">필요한 챕터를 다시 복습해 보세요.</p>
                <% end %>
              </aside>
            </div>
          </section>
        <% end %>
      </div>
    <% elsif @unowned_dashboards.any? %>
      <section aria-label="학습 중인 상품 없음" class="rounded-lg border border-gray-200 bg-white p-8 text-center shadow-sm">
        <p class="text-base font-semibold text-gray-900">아직 이용 중인 상품이 없습니다.</p>
        <p class="mt-1 text-sm text-gray-500">아래 카탈로그에서 관심 있는 라이선스를 둘러보세요!</p>
      </section>
    <% else %>
      <section aria-label="대시보드 안내" class="rounded-lg border border-gray-200 bg-white p-8 text-center shadow-sm">
        <p class="text-sm font-semibold text-gray-500">현재 대시보드에 표시할 상품이 없습니다.</p>
        <p class="mt-2 text-xs text-gray-400">판매 중인 유료 상품이 공개되면 이곳에서 학습 현황을 확인하실 수 있습니다.</p>
      </section>
    <% end %>

    <% if @unowned_dashboards.any? %>
      <section aria-label="전체 카탈로그 둘러보기" class="mt-12">
        <div class="mb-4">
          <h2 class="text-xl font-bold text-gray-900">전체 카탈로그 둘러보기</h2>
          <p class="mt-1 text-sm text-gray-600">다양한 커리큘럼을 둘러보고 새로운 스킬을 습득하세요.</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% @unowned_dashboards.each do |pd| %>
            <% product = pd[:product] %>
            <div class="flex flex-col justify-between rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <h3 class="text-lg font-bold text-gray-900"><%= product.name %></h3>
                  <%= product_status_badge(current_user, product) %>
                </div>
                <p class="mt-2 text-sm text-gray-600 leading-relaxed"><%= product.tagline %></p>
                <% trial_boost = current_user.trial_active? && pd[:accessible] != pd[:accessible_after_trial] %>
                <div class="mt-4 rounded-md bg-gray-50 p-3 text-xs text-gray-500">
                  <p class="font-medium text-gray-700">접근 가능 문서: <%= pd[:accessible] %>/<%= pd[:total] %><%= " (체험 중)" if trial_boost %></p>
                  <% if trial_boost %>
                    <p class="mt-0.5 text-gray-500"><%= I18n.l(current_user.trial_ends_on, locale: :ko, format: :long) %> 이후 <%= pd[:accessible_after_trial] %>/<%= pd[:total] %></p>
                  <% end %>
                  <p class="mt-0.5"><%= product_period_text(current_user, product) %></p>
                </div>
              </div>
              <div class="mt-6">
                <%= link_to "라이선스 둘러보기",
                  pricing_path,
                  class: "block w-full rounded-lg bg-gray-900 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-gray-800" %>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>
</div>
