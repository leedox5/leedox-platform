<% content_for :title, "대시보드 | LEEDOX" %>
<%# Handoff 0079 -- copy in the tone of the story-series site (no "학습/커리큘럼/스킬"), no internal notes, no product
    name repeated under a card title that already shows it, a product-page button on the not-yet-seen cards, and the
    common footer. Which products appear, and the owned/trial/expired judgments, are unchanged.
    Handoff 0080 -- the series in use come first (D-009); the empty box only when there's neither a series nor a
    standalone product in use; a standalone product whose license ran out reads 만료.
    Handoff 0084 (D-010) -- dark body like the home and the series pages (colors only; content unchanged), with the
    display serif for the page and section headings.
    Handoff 0085 R1 -- "what can I watch": the earlier products only while in use, under an 이전 상품 heading, and
    더 둘러보기 shows the series not in use (the /products card, at most four) instead of earlier products. %>
<% content_for :head do %>
  <%= render "shared/display_font" %>
<% end %>
<div class="min-h-screen bg-[#0e1014] text-[#f2efe8]">
  <%= render "shared/header" %>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-[#f0a53c]">My Dashboard</p>
        <h1 class="mt-1 font-display text-3xl font-bold text-[#f2efe8]">
          안녕하세요, <%= current_user.name %>님
        </h1>
        <p class="mt-2 text-[#c9c4ba]">보던 곳에서 이어서 보세요.</p>
      </div>

      <%= link_to "결제·라이선스 내역은 마이페이지에서 →",
        mypage_path,
        class: "text-sm font-semibold text-[#f0a53c] hover:text-[#f5b85e]" %>
    </header>

    <% if current_user.trial_active? && @has_unowned_product %>
      <p class="mb-6 rounded-lg border border-white/10 bg-[#15181e] px-4 py-3 text-sm font-semibold text-[#f2efe8]">
        무료 체험 D-<%= current_user.trial_days_remaining %> · <%= I18n.l(current_user.trial_ends_on, locale: :ko, format: :long) %>까지 — 체험 기간에는 상품별로 더 많은 챕터가 열립니다. 기간이 끝나면 비로그인 방문자와 같은 범위로 돌아갑니다.
      </p>
    <% elsif current_user.trial_recently_expired? && @has_unowned_product %>
      <p class="mb-6 rounded-lg border border-[#f0a53c]/40 bg-[#f0a53c]/10 px-4 py-3 text-sm font-semibold text-[#f0a53c]">
        무료 체험 기간이 끝났습니다. 지금은 비로그인 방문자와 같은 범위까지 열려 있습니다. 이어서 읽으려면 라이선스를 확인해보세요.
        <%= link_to "가격 보기 →", pricing_path, class: "underline decoration-[#f0a53c]/60 underline-offset-2 hover:text-[#f5b85e]" %>
      </p>
    <% end %>

    <% if @series_in_use.any? %>
      <section aria-label="이용 중인 시리즈" class="mb-10">
        <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="font-display text-xl font-bold text-[#f2efe8]">이용 중인 시리즈</h2>
          <%= link_to "시리즈 둘러보기 →", products_path, class: "text-sm font-semibold text-[#f0a53c] hover:text-[#f5b85e]" %>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          <% @series_in_use.each do |line| %>
            <%= render "dashboard/series_card", line: line, license: @series_licenses[line.id] %>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @owned_dashboards.any? %>
      <h2 class="mb-4 font-display text-xl font-bold text-[#f2efe8]">이전 상품</h2>
      <div class="space-y-6">
        <% @owned_dashboards.each do |pd| %>
          <% product = pd[:product] %>
          <section aria-label="<%= product.name %> 현황" class="rounded-2xl border border-white/10 bg-[#15181e] p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-bold text-[#f2efe8]"><%= product.name %></h2>
              <%= product_status_badge(current_user, product) %>
            </div>
            <p class="mt-1 text-sm text-[#c9c4ba]"><%= product_period_text(current_user, product) %></p>

            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div class="rounded-lg bg-white/5 p-4">
                <p class="text-sm font-semibold text-[#a8a39a]">볼 수 있는 챕터</p>
                <p class="mt-1 text-2xl font-bold text-[#f2efe8]"><%= pd[:accessible] %>/<%= pd[:total] %></p>
              </div>

              <div class="rounded-lg bg-white/5 p-4">
                <div class="flex items-center justify-between">
                  <p class="text-sm font-semibold text-[#a8a39a]">진행률</p>
                  <strong class="text-lg text-[#f0a53c]"><%= pd[:progress_percent] %>%</strong>
                </div>
                <p class="mt-1 text-xs text-[#a8a39a]"><%= pd[:total] %>개 중 <%= pd[:completed_count] %>개 읽음</p>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/15"
                     role="progressbar"
                     aria-label="<%= product.name %> 진행률"
                     aria-valuenow="<%= pd[:progress_percent] %>"
                     aria-valuemin="0"
                     aria-valuemax="100">
                  <div class="h-full rounded-full bg-[#f0a53c] transition-all" style="width: <%= pd[:progress_percent] %>%"></div>
                </div>
              </div>
            </div>

            <div class="mt-6 grid gap-4 lg:grid-cols-3">
              <div class="rounded-lg border border-white/10 p-5 lg:col-span-2">
                <div class="flex items-center justify-between gap-4">
                  <h3 class="font-semibold text-[#f2efe8]">최근에 읽은 챕터</h3>
                  <%= link_to "전체 보기", product_content_index_path(product.code), class: "text-sm font-semibold text-[#f0a53c] hover:text-[#f5b85e]" %>
                </div>

                <% if pd[:recent_chapters].any? %>
                  <ul class="mt-3 divide-y divide-white/10">
                    <% pd[:recent_chapters].each do |chapter| %>
                      <li class="flex items-center justify-between gap-4 py-3">
                        <div class="min-w-0">
                          <p class="text-xs text-[#a8a39a]">Chapter <%= chapter[:id] %></p>
                          <p class="truncate text-sm font-medium text-[#f2efe8]"><%= chapter[:title] %></p>
                        </div>
                        <%= link_to "다시 보기",
                          product_chapter_path(product.code, chapter[:id]),
                          class: "shrink-0 text-sm font-semibold text-[#f0a53c] hover:text-[#f5b85e]" %>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <div class="mt-3 rounded-lg bg-white/5 p-5 text-center">
                    <p class="text-sm text-[#c9c4ba]">아직 읽은 챕터가 없습니다.</p>
                  </div>
                <% end %>
              </div>

              <aside class="rounded-lg border border-[#f0a53c]/30 bg-[#f0a53c]/10 p-5 text-[#f2efe8]">
                <p class="text-xs font-semibold uppercase tracking-wide text-[#f0a53c]">다음 챕터</p>
                <% if pd[:next_chapter] %>
                  <h3 class="mt-2 text-lg font-bold"><%= pd[:next_chapter][:title] %></h3>
                  <p class="mt-1 text-xs text-[#c9c4ba]">Chapter <%= pd[:next_chapter][:id] %></p>
                  <%= link_to (pd[:completed_count].zero? ? "첫 챕터 시작" : "이어서 보기"),
                    product_chapter_path(product.code, pd[:next_chapter][:id]),
                    class: "mt-4 block rounded-lg bg-[#f0a53c] px-4 py-2 text-center text-sm font-semibold text-[#0e1014] transition hover:bg-[#f5b85e]" %>
                <% else %>
                  <h3 class="mt-2 text-lg font-bold">모든 챕터를 읽었습니다.</h3>
                  <p class="mt-1 text-xs text-[#c9c4ba]">필요한 챕터를 다시 읽어 보세요.</p>
                <% end %>
              </aside>
            </div>
          </section>
        <% end %>
      </div>
    <% elsif @series_in_use.none? %>
      <section aria-label="이용 중인 콘텐츠 없음" class="rounded-2xl border border-white/10 bg-[#15181e] p-8 text-center">
        <p class="text-base font-semibold text-[#f2efe8]">아직 이용 중인 콘텐츠가 없습니다.</p>
        <% if @browse_series.any? %>
          <p class="mt-1 text-sm text-[#c9c4ba]">아래에서 관심 있는 콘텐츠를 둘러보세요.</p>
        <% else %>
          <%= link_to "시리즈 둘러보기 →", products_path, class: "mt-2 inline-block text-sm font-semibold text-[#f0a53c] hover:text-[#f5b85e]" %>
        <% end %>
      </section>
    <% end %>

    <% if @browse_series.any? %>
      <section aria-label="더 둘러보기" class="mt-12">
        <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="font-display text-xl font-bold text-[#f2efe8]">더 둘러보기</h2>
            <p class="mt-1 text-sm text-[#c9c4ba]">다른 이야기도 둘러보세요.</p>
          </div>
          <%# The series link sits on the series section's heading when that section shows -- never twice. It also
              leads to the rest when there are more series than the four shown here. %>
          <% unless @series_in_use.any? %>
            <%= link_to "시리즈 둘러보기 →", products_path, class: "text-sm font-semibold text-[#f0a53c] hover:text-[#f5b85e]" %>
          <% end %>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <% @browse_series.each do |line| %>
            <%= render "product_lines/list_card", line: line, state: @browse_states[line.id],
              published_count: @browse_published_counts.fetch(line.id, 0), heading: :h3 %>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>

  <%= render "shared/footer" %>
</div>
