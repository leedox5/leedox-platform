<%# Handoff 0080 -- one series the member can use right now. Same look as a /products card (cover partials, name,
    summary, episode count, badge) but not one big link, because it carries two: the home hero's "first episode"
    button (series_start_label -> the first published episode) and 시리즈 소개. No progress: nothing records which
    episodes a member has read.
    Handoff 0084 (D-010) -- dark, in the home / series-list card's colors. %>
<% published = @series_published_counts.fetch(line.id, 0) %>
<% upcoming = @series_upcoming_counts.fetch(line.id, 0) %>
<% first = @series_first_episodes[line.id] %>
<article class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#15181e]" data-series-card="<%= line.slug %>">
  <% if line.cover_image.attached? %>
    <%= render "product_lines/cover_image", product_line: line, variant: :thumb, classes: "block aspect-video w-full object-cover" %>
  <% else %>
    <%= render "product_lines/cover_placeholder", product_line: line, dark: true %>
  <% end %>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="break-words text-lg font-bold text-[#f2efe8]"><%= line.customer_name %></h3>
      <span class="inline-flex shrink-0 whitespace-nowrap rounded-full border border-[#7dd3a8]/40 bg-[#7dd3a8]/10 px-3 py-1 text-xs font-semibold text-[#7dd3a8]">이용 중</span>
    </div>
    <% if line.summary.present? %>
      <p class="mt-1 break-words text-sm text-[#c9c4ba]"><%= line.summary %></p>
    <% end %>
    <p class="mt-3 text-xs font-semibold text-[#a8a39a]">공개 <%= published %>편<% if upcoming.positive? %> · 공개 예정 <%= upcoming %>편<% end %></p>
    <p class="mt-1 text-sm text-[#c9c4ba]"><%= dashboard_license_period_text(license) %></p>
    <div class="mt-auto pt-5">
      <% if first %>
        <%= link_to series_start_label, product_episode_path(line.slug, first.display_id), data: { turbo_prefetch: false },
          class: "block w-full rounded-lg bg-[#f0a53c] px-4 py-2.5 text-center text-sm font-semibold text-[#0e1014] transition hover:bg-[#f5b85e]" %>
      <% end %>
      <%= link_to "시리즈 소개", product_line_path(line.slug),
        class: "#{first ? "mt-2 text-xs" : "text-sm"} block text-center font-semibold text-[#a8a39a] hover:text-[#f2efe8]" %>
    </div>
  </div>
</article>
