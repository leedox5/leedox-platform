<%# Handoff 0080 -- one series the member can use right now. Same look as a /products card (cover partials, name,
    summary, episode count, badge) but not one big link, because it carries two: the home hero's "first episode"
    button (series_start_label -> the first published episode) and 시리즈 소개. No progress: nothing records which
    episodes a member has read. %>
<% published = @series_published_counts.fetch(line.id, 0) %>
<% upcoming = @series_upcoming_counts.fetch(line.id, 0) %>
<% first = @series_first_episodes[line.id] %>
<article class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm" data-series-card="<%= line.slug %>">
  <% if line.cover_image.attached? %>
    <%= render "product_lines/cover_image", product_line: line, variant: :thumb, classes: "block aspect-video w-full object-cover" %>
  <% else %>
    <%= render "product_lines/cover_placeholder", product_line: line %>
  <% end %>
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="break-words text-lg font-bold text-gray-900"><%= line.customer_name %></h3>
      <span class="inline-flex shrink-0 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">이용 중</span>
    </div>
    <% if line.summary.present? %>
      <p class="mt-1 break-words text-sm text-gray-600"><%= line.summary %></p>
    <% end %>
    <p class="mt-3 text-xs font-semibold text-gray-500">공개 <%= published %>편<% if upcoming.positive? %> · 공개 예정 <%= upcoming %>편<% end %></p>
    <p class="mt-1 text-sm text-gray-600"><%= dashboard_license_period_text(license) %></p>
    <div class="mt-auto pt-5">
      <% if first %>
        <%= link_to series_start_label, product_episode_path(line.slug, first.display_id), data: { turbo_prefetch: false },
          class: "block w-full rounded-lg bg-gray-900 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-gray-800" %>
      <% end %>
      <%= link_to "시리즈 소개", product_line_path(line.slug),
        class: "#{first ? "mt-2 text-xs" : "text-sm"} block text-center font-semibold text-gray-500 hover:text-gray-700" %>
    </div>
  </div>
</article>
