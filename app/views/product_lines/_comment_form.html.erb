<%# Handoff 0074 -- the comment (or, with `parent`, reply) form. `comment` is the rejected record when the page is
    re-rendered after a failed save, so the text and the reason stay; otherwise a blank one. %>
<% parent = local_assigns[:parent] %>
<%= form_with model: comment, url: product_episode_comments_path(@product_line.slug, @current_episode.display_id), class: "mt-2" do |form| %>
  <% if parent %><%= form.hidden_field :parent_id, value: parent.id %><% end %>
  <% if comment.errors.any? %>
    <p class="mb-2 text-sm font-semibold text-danger" role="alert"><%= comment.errors[:body].first || comment.errors[:base].first %></p>
  <% end %>
  <%= form.text_area :body, rows: parent ? 2 : 3, maxlength: EpisodeComment::MAX_LENGTH, required: true,
    placeholder: parent ? "답글을 남겨 주세요" : "이 편에 대한 생각이나 막힌 곳을 남겨 주세요",
    "aria-label": parent ? "답글" : "댓글",
    class: "block w-full rounded-lg border border-line/15 bg-card px-3 py-2 text-[15px] text-ink placeholder:text-ink-3 focus:border-accent-soft focus:outline-none focus:ring-1 focus:ring-accent-soft" %>
  <div class="mt-2 flex items-center justify-between gap-3">
    <span class="text-xs text-ink-3"><%= EpisodeComment::MAX_LENGTH %>자까지</span>
    <%= form.submit parent ? "답글 등록" : "댓글 등록", class: "cursor-pointer rounded-lg bg-accent px-4 py-2 text-sm font-bold text-on-accent hover:bg-accent-hover" %>
  </div>
<% end %>
