<%# Handoff 0069 R3 -- the episode card list, shared by the customer page and the admin preview so the two can
    never drift (only the link target and whether draft episodes are included differ, and those are already the
    caller's job via `episodes` and `admin:`). A "에피소드" heading sits above the cards, styled exactly like a
    subheading inside the intro guide (`.doc-content h2`: text-2xl font-semibold text-slate-900, mt-8/mb-3) so it
    reads as one more subheading in the same flow -- and only when there's at least one card to show; a product
    with no visible episodes gets no heading at all, just the empty-state line it already had.
    Handoff 0070 -- on the customer page (never the admin preview -- draft episodes are already ordinary,
    editable cards there), titled draft episodes follow the published ones as non-interactive "공개 예정" cards
    (`_upcoming_episode_card`, no link, no CTA). The admin preview never passes `upcoming_episodes`, so it keeps
    its old behaviour exactly. %>
<% admin = local_assigns.fetch(:admin, false) %>
<%# Handoff 0083 R2 -- `dark: true` on the customer page only (SeriesThemeHelper); the admin preview is unchanged. %>
<% dark = local_assigns.fetch(:dark, false) %>
<% upcoming_episodes = local_assigns.fetch(:upcoming_episodes, []) %>
<% if series_episode_section?(episodes, upcoming_episodes) %>
  <%# Handoff 0090 -- #episodes (customer page only) is a permanent address: the section links and the dashboard's
      in-use card jump here; scroll-mt keeps the heading clear of the header + section links. %>
  <h2 <% unless admin %>id="<%= ProductLinesHelper::SERIES_SECTION_IDS[:episodes] %>"<% end %> class="scroll-mt-28 <%= series_theme(:list_heading, dark) %>">에피소드</h2>
  <ol class="space-y-3">
    <% episodes.each do |episode| %>
      <%# Handoff 0092 R3 -- `cta_for` (customer page): what this viewer's click on each card does. R4 -- a card the
          viewer can't open yet goes to /products/:slug/continue?to=NN (sign in / start / buy, then that episode). %>
      <% cta = local_assigns[:cta_for]&.call(episode) %>
      <% path = if admin then admin_content_episode_path(episode)
                elsif cta&.last then product_continue_path(product_line.slug, to: episode.display_id)
                else product_episode_path(product_line.slug, episode.display_id) end %>
      <li><%= render "product_lines/episode_card", episode: episode, admin: admin, dark: dark, **(cta ? { cta: cta } : {}), path: path %></li>
    <% end %>
    <% upcoming_episodes.each do |episode| %>
      <li><%= render "product_lines/upcoming_episode_card", episode: episode, dark: dark %></li>
    <% end %>
  </ol>
<% else %>
  <p class="<%= series_theme(:list_empty, dark) %>"><%= admin ? "아직 편이 없습니다." : "준비 중입니다." %></p>
<% end %>
