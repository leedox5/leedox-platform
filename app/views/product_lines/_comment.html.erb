<%# Handoff 0074 -- one comment or reply on the customer episode page. The body is plain text: ERB escapes it (no
    HTML/markdown, no auto-linking) and whitespace-pre-wrap keeps the author's line breaks. A top-level comment that
    isn't visible any more is rendered as a placeholder line instead (its replies stay below it).
    R2 -- an admin also sees a hidden (not deleted) comment, dimmed and labelled 숨김, and gets 숨김 / 숨김 해제 on
    every live comment. Those buttons post to the admin controller, which brings the admin back here. %>
<% reply = comment.reply? %>
<% admin = current_user&.admin? %>
<% shown = comment.visible? || (admin && comment.hidden? && !comment.deleted?) %>
<%# Handoff 0084 R2 -- dark; a hidden comment (admin only) is dimmed to 75% (was 50%) so even its time and buttons
    still read at >= 4.5:1. %>
<div id="comment-<%= comment.id %>" class="<%= reply ? "ml-6 border-l-2 border-line/10 pl-4 sm:ml-8" : "" %> <%= "opacity-75" if shown && comment.hidden? %> scroll-mt-24 py-3">
  <% if shown %>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <%= comment_author_label(comment) %>
      <span class="text-xs text-ink-3"><%= comment_time(comment) %></span>
      <% if comment.hidden? %>
        <span class="rounded-full border border-line/15 bg-tint/5 px-2 py-0.5 text-[11px] font-bold text-ink-2">숨김</span>
      <% end %>
      <span class="ml-auto flex items-center gap-3">
        <% if admin %>
          <%= button_to comment.hidden? ? "숨김 해제" : "숨김",
            comment.hidden? ? unhide_admin_episode_comment_path(comment, from: "episode") : hide_admin_episode_comment_path(comment, from: "episode"),
            method: :patch, class: "text-xs font-semibold text-ink-3 hover:text-accent-ink" %>
        <% end %>
        <% if comment.authored_by?(current_user) %>
          <%= button_to "삭제", product_episode_comment_path(@product_line.slug, @current_episode.display_id, comment),
            method: :delete, data: { turbo_confirm: "이 댓글을 삭제할까요?" },
            class: "text-xs font-semibold text-ink-3 hover:text-danger" %>
        <% end %>
      </span>
    </div>
    <p class="mt-1 whitespace-pre-wrap break-words text-[15px] leading-relaxed text-ink-2"><%= comment.body %></p>
  <% else %>
    <p class="text-sm italic text-ink-3"><%= comment_placeholder(comment) %></p>
  <% end %>
</div>
