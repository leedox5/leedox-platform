<%# Handoff 0070 -- a "공개 예정" card: a titled draft episode of the same product, listed after the published
    cards so the season reads whole (D-008). Deliberately a <div>, never a link -- no href, no CTA, not focusable
    or clickable -- because the episode's body/URL is still gated exactly as before (404 on direct access; this
    card never claims otherwise). Same one-row layout as the customer's published card (0067: the title on the
    left, no episode number, a fixed label on the right that's forced to its own line below `sm`) so the season
    reads as one continuous list, just muted (gray, lower opacity) to read as "not yet". %>
<% dark = local_assigns.fetch(:dark, false) %>
<div class="<%= series_theme(:upcoming_card, dark) %>">
  <%# Handoff 0094 R2 (③) -- phones: the title wraps across the card, 공개 예정 leads the second line (" · " teaser);
      from sm: 공개 예정 on the title's row and the teaser below, as before. %>
  <div class="<%= series_theme(:card_row, dark) %>">
    <span class="<%= series_theme(:upcoming_title, dark) %>" title="<%= episode.customer_title %>"><%= episode.customer_title %></span>
    <span class="<%= series_theme(:upcoming_label, dark) %>">공개 예정</span>
  </div>
  <p class="<%= series_theme(:upcoming_summary, dark) %><%= " sm:hidden" if episode.summary.blank? %>">
    <span class="<%= series_theme(:upcoming_meta_status, dark) %>">공개 예정</span>
    <% if episode.summary.present? %>
      <span class="<%= dark ? "sm:hidden" : "hidden" %>" aria-hidden="true">·</span>
      <span class="min-w-0 truncate" title="<%= episode.summary %>"><%= episode.summary %></span>
    <% end %>
  </p>
</div>
