<%# Access state of a license-gated product (handoff 0057; per product line since 0065): purchase for a priced
    product, an explicit "무료 이용 시작" for a 0-won one. A product without a commerce Product renders nothing.
    Handoff 0068 -- which of these four states applies now comes from ProductLine#access_state, the same call the
    product list uses, so the two can't disagree about a product's state; only which HTML to show for it stays here. %>
<%# Handoff 0083 R2 -- colors from SeriesThemeHelper (`dark:` on the customer page); content and conditions unchanged.
    Handoff 0092 R1 (D-012) -- shorter boxes: in use is one line whatever the source (free start or purchase -- so a
    free starter no longer reads "구매한 …"), and a free guide not started yet is one line plus 이용하기. What the button
    does is unchanged (guests: the checkout path, which signs them in first; members: the free-start POST). The
    for-sale and closed boxes are unchanged. %>
<% dark = local_assigns.fetch(:dark, false) %>
<% state = product_line.access_state(owned: owned) %>
<%# Handoff 0092 R3 -- the first 열린 편 the viewer can read without the license (nil when there's none or they have
    it). A guest is told it opens without signing in; a member who hasn't bought a paid guide, before buying. A member
    who hasn't started a free guide gets no line (이용하기 is right there). %>
<% open_episode = local_assigns[:open_episode] %>
<% open_line = if open_episode.nil? then nil elsif !user_signed_in? then "로그인 없이" elsif state == :for_sale then "구매 전에" end %>
<% if state %>
  <section class="mt-6 rounded-2xl border <%= series_theme(:box, dark) %> p-5" aria-label="이용 안내" id="product-purchase">
    <% if state == :owned %>
      <p class="font-bold <%= series_theme(:box_title, dark) %>">이용 중인 가이드입니다.</p>
    <% elsif state == :free_open %>
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
        <p class="min-w-0 flex-1 basis-64 text-sm <%= series_theme(:box_text, dark) %>">지금은 모든 에피소드를 무료로 이용할 수 있습니다. 시작해 두면 계속 볼 수 있습니다.</p>
        <% if user_signed_in? %>
          <%= button_to "이용하기", claim_free_access_path(product_line.product.code), method: :post,
            class: "inline-flex flex-shrink-0 items-center justify-center whitespace-nowrap rounded-xl px-6 py-3 text-sm font-bold #{series_theme(:free_button, dark)}" %>
        <% else %>
          <%= link_to "이용하기", billing_checkout_path(product_line.product.code),
            class: "inline-flex flex-shrink-0 items-center justify-center whitespace-nowrap rounded-xl px-6 py-3 text-sm font-bold #{series_theme(:free_button, dark)}" %>
        <% end %>
      </div>
      <%= render "product_lines/open_episode_line", product_line: product_line, episode: open_episode, when_text: open_line, dark: dark if open_line %>
    <% elsif state == :for_sale %>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-wide <%= series_theme(:box_label, dark) %>">한 번 결제 · 무기한 이용</p>
          <p class="mt-1 text-2xl font-black <%= series_theme(:box_price, dark) %>"><%= number_with_delimiter(offer.total_amount) %>원 <span class="text-sm font-semibold <%= series_theme(:box_muted, dark) %>">(VAT 포함)</span></p>
        </div>
        <%= link_to "구매하기", billing_checkout_path(product_line.product.code),
          class: "inline-flex flex-shrink-0 items-center justify-center whitespace-nowrap rounded-xl px-6 py-3 text-sm font-bold #{series_theme(:buy_button, dark)}" %>
      </div>
      <p class="mt-3 text-xs <%= series_theme(:box_note, dark) %>">구매하면 이 가이드의 모든 편과 산출물을 이용할 수 있습니다. 다른 가이드는 포함되지 않습니다.</p>
      <%= render "product_lines/open_episode_line", product_line: product_line, episode: open_episode, when_text: open_line, dark: dark if open_line %>
    <% else %>
      <p class="font-bold <%= series_theme(:box_closed, dark) %>">현재 <%= free ? "시작할" : "구매할" %> 수 없습니다</p>
      <p class="mt-1 text-sm <%= series_theme(:box_note, dark) %>">이 가이드는 준비 중이거나 이용 시작이 중지되었습니다. 이미 이용 중인 분은 로그인하면 계속 이용하실 수 있습니다.</p>
    <% end %>
  </section>
<% end %>
