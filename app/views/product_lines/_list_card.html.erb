<%# One series card of the series list (/products, handoff 0068/0083) -- also the dashboard's 다른 콘텐츠 (0085) and,
    since 0089, its series in use, so all three show the same cover, name, summary, 공개 N편, badge and 자세히 보기 →
    with the same hover. `heading:` is the title's tag (h2 on the list, h3 under a dashboard heading).
    Dashboard-only extras (0089): `badge:` [label, classes] in place of the list's state badge, `period:` a line under
    공개 N편 (the license period), `data:` attributes for the link. %>
<% badge = local_assigns[:badge] %>
<%= link_to product_line_path(line.slug), data: local_assigns.fetch(:data, {}),
  class: "flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#15181e] transition hover:border-[#f0a53c]/60" do %>
  <% if line.cover_image.attached? %>
    <%= render "product_lines/cover_image", product_line: line, variant: :thumb, classes: "block aspect-video w-full object-cover" %>
  <% else %>
    <%= render "product_lines/cover_placeholder", product_line: line, dark: true %>
  <% end %>
  <div class="flex flex-1 flex-col p-5">
    <%= content_tag local_assigns.fetch(:heading, :h2), line.customer_name, class: "break-words text-lg font-bold text-[#f2efe8]" %>
    <% if line.summary.present? %>
      <p class="mt-1 break-words text-sm text-[#c9c4ba]"><%= line.summary %></p>
    <% end %>
    <p class="mt-3 text-xs font-semibold text-[#a8a39a]">공개 <%= published_count %>편</p>
    <% if local_assigns[:period] %>
      <p class="mt-1 text-sm text-[#c9c4ba]"><%= period %></p>
    <% end %>
    <div class="mt-4 flex flex-1 items-end justify-between gap-3">
      <% if badge %>
        <span class="<%= badge.last %>"><%= badge.first %></span>
      <% elsif state %>
        <span class="<%= product_list_state_classes(state) %>"><%= product_list_state_label(state, line) %></span>
      <% end %>
      <span class="flex-shrink-0 whitespace-nowrap text-sm font-semibold text-[#f0a53c]">자세히 보기 →</span>
    </div>
  </div>
<% end %>
