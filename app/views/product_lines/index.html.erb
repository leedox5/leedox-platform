<%# Handoff 0068 -- every listed (public, published) ProductLine, oldest first. Card-per-product, whole card is
    the link to the detail page (never a link inside a link). Price/access uses the exact same judgment the
    detail page's purchase box uses (ProductLine#access_state), computed once in the controller and reused here
    for both the filter (R2) and the badge, so list and detail never disagree and it's never queried twice. %>
<%# Handoff 0083 -- dark like the home ("browse" pages are dark, reading/handling pages light): the home's palette
    (#0e1014 page, #15181e cards, #f2efe8 / #c9c4ba / #a8a39a text, #f0a53c accent), its dark header and its display
    serif. Only colors and fonts changed; what shows (cards, badges, filters, links) is the same. %>
<% content_for :title, "시리즈 | LEEDOX" %>
<% content_for :head do %>
  <%= render "shared/display_font" %>
<% end %>

<div class="min-h-screen bg-[#0e1014] text-[#f2efe8]">
  <%= render "shared/header", dark: true %>

  <main class="mx-auto w-full max-w-6xl px-4 py-10 sm:px-6">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.18em] text-[#f0a53c]">Series</p>
        <h1 class="mt-2 break-keep font-display text-3xl font-bold tracking-tight text-[#f2efe8] sm:text-4xl">시리즈</h1>
      </div>
      <%# R2 -- filter tabs, plain links (work with no JS); the current one is the only visual state that matters. %>
      <nav aria-label="시리즈 필터" class="flex flex-wrap items-center gap-2">
        <% product_list_filter_options.each do |value, label| %>
          <%= link_to "#{label} #{@filter_counts.fetch(value, @filter_counts["all"])}",
            value == "all" ? products_path : products_path(filter: value),
            class: product_list_filter_tab_classes(@filter == value) %>
        <% end %>
      </nav>
    </div>

    <% if @product_lines.empty? %>
      <p class="text-[#c9c4ba]">
        <%= product_list_empty_message(@filter) %>
        <% if @filter != "all" %><%= link_to "전체 보기", products_path, class: "font-bold text-[#f0a53c] hover:underline" %><% end %>
      </p>
    <% else %>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @product_lines.each do |line| %>
          <% state = @access_states[line.id] %>
          <%= link_to product_line_path(line.slug), class: "flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#15181e] transition hover:border-[#f0a53c]/60" do %>
            <% if line.cover_image.attached? %>
              <%= render "product_lines/cover_image", product_line: line, variant: :thumb, classes: "block aspect-video w-full object-cover" %>
            <% else %>
              <%= render "product_lines/cover_placeholder", product_line: line, dark: true %>
            <% end %>
            <div class="flex flex-1 flex-col p-5">
              <h2 class="break-words text-lg font-bold text-[#f2efe8]"><%= line.customer_name %></h2>
              <% if line.summary.present? %>
                <p class="mt-1 break-words text-sm text-[#c9c4ba]"><%= line.summary %></p>
              <% end %>
              <p class="mt-3 text-xs font-semibold text-[#a8a39a]">공개 <%= @published_episode_counts.fetch(line.id, 0) %>편</p>
              <div class="mt-4 flex flex-1 items-end justify-between gap-3">
                <% if state %>
                  <span class="<%= product_list_state_classes(state) %>"><%= product_list_state_label(state, line) %></span>
                <% end %>
                <span class="flex-shrink-0 whitespace-nowrap text-sm font-semibold text-[#f0a53c]">자세히 보기 →</span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </main>

  <%= render "shared/footer" %>
</div>
