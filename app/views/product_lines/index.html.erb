<%# Handoff 0068 -- every listed (public, published) ProductLine, oldest first. Card-per-product, whole card is
    the link to the detail page (never a link inside a link). Price/access uses the exact same judgment the
    detail page's purchase box uses (ProductLine#access_state), computed once in the controller and reused here
    for both the filter (R2) and the badge, so list and detail never disagree and it's never queried twice. %>
<%# Handoff 0083 -- dark like the home ("browse" pages are dark, reading/handling pages light): the home's palette
    (#0e1014 page, #15181e cards, #f2efe8 / #c9c4ba / #a8a39a text, #f0a53c accent), its dark header and its display
    serif. Only colors and fonts changed; what shows (cards, badges, filters, links) is the same. %>
<% content_for :title, "가이드 | LEEDOX" %>
<% content_for :color_scheme, "dark" %><%# Handoff 0100 -- a dark page (FrameThemeHelper#body_class) %>
<% content_for :head do %>
  <%= render "shared/display_font" %>
<% end %>

<div class="min-h-screen bg-page text-ink">
  <%= render "shared/header", dark: true %>

  <%# Handoff 0104 -- 10px side margins on phones like the home and the guide page (0094); sm and up as before. The
      title and the filter tabs share one row (no Guides label); tabs that don't fit drop to a second row, kept on the
      right. %>
  <main class="mx-auto w-full max-w-6xl px-2.5 pt-4 pb-10 sm:px-6 sm:py-10">
    <div class="mb-3.5 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:mb-8 sm:items-end sm:gap-4">
      <h1 class="break-keep font-display text-2xl font-bold tracking-tight text-ink sm:text-4xl">가이드</h1>
      <%# R2 -- filter tabs, plain links (work with no JS); the current one is the only visual state that matters.
          0104 -- a tab with nothing in it isn't drawn, unless it's 전체 or the one you're on. %>
      <nav aria-label="가이드 필터" class="ml-auto flex flex-wrap items-center justify-end gap-1.5 sm:gap-2">
        <% product_list_visible_filter_options(@filter_counts, @filter).each do |value, label| %>
          <%= link_to "#{label} #{@filter_counts.fetch(value, @filter_counts["all"])}",
            value == "all" ? products_path : products_path(filter: value),
            class: product_list_filter_tab_classes(@filter == value) %>
        <% end %>
      </nav>
    </div>

    <% if @product_lines.empty? %>
      <p class="text-ink-2">
        <%= product_list_empty_message(@filter) %>
        <% if @filter != "all" %><%= link_to "전체 보기", products_path, class: "font-bold text-accent-ink hover:underline" %><% end %>
      </p>
    <% else %>
      <div class="grid gap-2.5 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
        <% @product_lines.each do |line| %>
          <%= render "product_lines/guide_card", line: line, state: @access_states[line.id],
            published_count: @published_episode_counts.fetch(line.id, 0) %>
        <% end %>
      </div>
    <% end %>
  </main>

  <%= render "shared/footer" %>
</div>
