<%# Handoff 0084 R2 (D-010) -- an episode is "series viewing", so its body is dark like the series pages (colors only;
    content, links, the prefetch opt-out on episode links (0073) and the comment flow are unchanged). The body Markdown
    gets .doc-content-dark (0083); images are left as they are, framed by its thin border.
    Handoff 0105 -- the guide's name is a small heading above the title (was a "← name" link), the title wraps between
    words, 최종 업데이트 moved to the end (date only), the prev / next row is left out when it would be empty, and phones
    get 10px margins and a tighter title block and end (the body's phone density is .doc-content-dark's, application.css).
    An episode with three or more h2s gets the sticky 길잡이 줄 (product_lines/_episode_toc) under the header. %>
<% content_for :title, "#{@current_episode.customer_title.presence || "(제목 없음)"} | LEEDOX" %>
<% content_for :color_scheme, "dark" %><%# Handoff 0100 -- a dark page (FrameThemeHelper#body_class) %>
<% content_for :head do %>
  <%= render "shared/display_font" %>
<% end %>
<div class="min-h-screen bg-page text-ink">
  <%= render "shared/header" %>
  <% if @episode_sections.size >= EpisodePage::TOC_MIN_SECTIONS %>
    <%= render "product_lines/episode_toc", sections: @episode_sections %>
  <% end %>
  <%# Handoff 0106 -- sm and up: 24px above (was 40), the title block 12px to its rule and 20px under it (was 16 / 32). %>
  <main class="mx-auto max-w-3xl px-2.5 pt-3 pb-10 sm:px-7 sm:pt-6">
    <div class="mb-3.5 border-b border-line/10 pb-2.5 sm:mb-5 sm:pb-3">
      <%= link_to @product_line.customer_name, product_line_path(@product_line.slug), data: { episode_guide_link: true },
        class: "inline-block text-xs font-bold text-accent-ink hover:underline" %>
      <h1 class="mt-1 break-keep break-words font-display text-[22px] font-bold leading-[30px] text-ink sm:text-3xl sm:leading-9"><%= @current_episode.customer_title.presence || "(제목 없음)" %></h1>
    </div>

    <div class="doc-content doc-content-dark max-w-none">
      <%= @content_html %>
    </div>

    <%# Handoff 0092 R2 -- on an 열린 편 without the license the 실전 자료 (takeaways and files) are one line instead;
        with no 실전 자료 at all there's no section, as before. %>
    <% if !@full_episode_access && (@takeaways.present? || @assets.present?) %>
      <section class="mt-10">
        <h2 class="text-lg font-bold text-ink">이 편의 실전 자료</h2>
        <p class="mt-3 rounded-lg bg-card px-4 py-3 text-sm text-ink-2">실전 자료는 이용을 시작하면 받을 수 있습니다.</p>
      </section>
    <% elsif @takeaways.present? || @assets.present? %>
      <section class="mt-10">
        <h2 class="text-lg font-bold text-ink">이 편의 실전 자료</h2>

        <% if @takeaways.present? %>
          <div class="mt-4 space-y-4">
            <% @takeaways.each do |takeaway| %>
              <div class="rounded-xl border border-accent-soft/30 bg-accent-soft/10 p-5">
                <p class="text-xs font-bold uppercase tracking-wide text-accent-ink"><%= takeaway[:kind] %></p>
                <div class="doc-content doc-content-dark mt-2 max-w-none text-sm">
                  <%= takeaway[:body_html] %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @assets.present? %>
          <div class="mt-4 space-y-3">
            <% @assets.each do |asset| %>
              <div class="flex flex-col gap-3 rounded-xl border border-line/10 bg-card p-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="text-xs font-bold uppercase tracking-wide text-accent-ink"><%= asset.kind %></p>
                  <p class="mt-1 font-bold text-ink"><%= asset.title %></p>
                  <% if asset.description.present? %><p class="mt-1 text-sm text-ink-2"><%= asset.description %></p><% end %>
                  <p class="mt-1 truncate text-xs text-ink-3"><%= asset.file.filename %> · <%= number_to_human_size(asset.file.byte_size) %></p>
                </div>
                <%= link_to "다운로드", product_episode_asset_path(@product_line.slug, @current_episode.display_id, asset.id),
                  class: "inline-flex flex-shrink-0 items-center justify-center rounded-lg bg-accent px-4 py-2 text-sm font-bold text-on-accent hover:bg-accent-hover" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <p class="mt-6 text-xs text-ink-3" data-episode-updated>최종 업데이트: <%= l(@current_episode.updated_at.to_date, format: :long, locale: :ko) %></p>

    <% if @prev_episode || (@next_episode && @full_episode_access) %>
    <div class="mt-6 flex justify-between border-t border-line/10 pt-5 sm:mt-16 sm:pt-8" data-episode-nav>
      <% if @prev_episode %>
        <%= link_to product_episode_path(@product_line.slug, @prev_episode.display_id), data: { turbo_prefetch: false }, class: "flex items-center gap-2 text-sm text-ink-3 hover:text-ink" do %>
          <span>←</span>
          <span><%= @prev_episode.customer_title.presence || "(제목 없음)" %></span>
        <% end %>
      <% else %>
        <div></div>
      <% end %>

      <%# Handoff 0092 R4 -- without the license (an 열린 편) the next episode wouldn't open, so the box below takes the
          place of this link. %>
      <% if @next_episode && @full_episode_access %>
        <%= link_to product_episode_path(@product_line.slug, @next_episode.display_id), data: { turbo_prefetch: false }, class: "flex items-center gap-2 text-sm text-ink-3 hover:text-ink" do %>
          <span><%= @next_episode.customer_title.presence || "(제목 없음)" %></span>
          <span>→</span>
        <% end %>
      <% end %>
    </div>
    <% end %>
    <% unless @full_episode_access %>
      <%= render "product_lines/continue_box", product_line: @product_line, next_episode: @next_episode %>
    <% end %>

    <%# Handoff 0074 -- nil when comments couldn't be loaded (EpisodePage#load_episode_comments): the episode still shows. %>
    <%# Handoff 0092 R2 -- without the license (an 열린 편): the count and one line; no list, no form. %>
    <% if @comment_threads && @full_episode_access %>
      <%= render "product_lines/comments" %>
    <% elsif @comment_threads %>
      <section id="comments" class="mt-7 scroll-mt-24 border-t border-line/10 pt-6 sm:mt-12 sm:pt-8">
        <h2 class="text-lg font-bold text-ink">댓글 <span class="text-ink-3"><%= @comment_count %></span></h2>
        <p class="mt-3 rounded-lg bg-card px-4 py-3 text-sm text-ink-2">이용을 시작하면 댓글을 보고 남길 수 있습니다.</p>
      </section>
    <% end %>
  </main>
</div>
