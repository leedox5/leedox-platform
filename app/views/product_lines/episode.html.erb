<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-5 py-10 sm:px-7">
    <%= link_to "← #{@product_line.customer_name}", product_line_path(@product_line.slug),
      class: "mb-3 inline-block text-sm text-gray-500 hover:text-blue-600" %>

    <div class="mb-8 border-b border-gray-100 pb-4">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600">Episode <%= @current_episode.display_id %></p>
      <h1 class="text-3xl font-bold text-gray-900"><%= @current_episode.customer_title.presence || "(제목 없음)" %></h1>
      <p class="mt-3 text-sm text-gray-500">최종 업데이트: <%= l(@current_episode.updated_at, format: :long, locale: :ko) %></p>
    </div>

    <div class="doc-content max-w-none">
      <%= @content_html %>
    </div>

    <% if @takeaways.present? || @assets.present? %>
      <section class="mt-10">
        <h2 class="text-lg font-bold text-gray-900">이 편의 실전 자료</h2>

        <% if @takeaways.present? %>
          <div class="mt-4 space-y-4">
            <% @takeaways.each do |takeaway| %>
              <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
                <p class="text-xs font-bold uppercase tracking-wide text-amber-700"><%= takeaway[:kind] %></p>
                <div class="doc-content mt-2 max-w-none text-sm">
                  <%= takeaway[:body_html] %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if @assets.present? %>
          <div class="mt-4 space-y-3">
            <% @assets.each do |asset| %>
              <div class="flex flex-col gap-3 rounded-xl border border-blue-200 bg-blue-50 p-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="text-xs font-bold uppercase tracking-wide text-blue-700"><%= asset.kind %></p>
                  <p class="mt-1 font-bold text-gray-900"><%= asset.title %></p>
                  <% if asset.description.present? %><p class="mt-1 text-sm text-gray-600"><%= asset.description %></p><% end %>
                  <p class="mt-1 truncate text-xs text-gray-500"><%= asset.file.filename %> · <%= number_to_human_size(asset.file.byte_size) %></p>
                </div>
                <%= link_to "다운로드", product_episode_asset_path(@product_line.slug, @current_episode.display_id, asset.id),
                  class: "inline-flex flex-shrink-0 items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>

    <div class="mt-16 flex justify-between border-t border-gray-100 pt-8">
      <% if @prev_episode %>
        <%= link_to product_episode_path(@product_line.slug, @prev_episode.display_id), class: "flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600" do %>
          <span>←</span>
          <span><%= @prev_episode.customer_title.presence || "(제목 없음)" %></span>
        <% end %>
      <% else %>
        <div></div>
      <% end %>

      <% if @next_episode %>
        <%= link_to product_episode_path(@product_line.slug, @next_episode.display_id), class: "flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600" do %>
          <span><%= @next_episode.customer_title.presence || "(제목 없음)" %></span>
          <span>→</span>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
