<%# Handoff 0074 -- the comment section under the customer episode page (never the admin preview, which has its own
    template). Only ever rendered after the episode gates passed, so whoever sees it can read the episode.
    Signed-in viewers get the form; a guest (only possible on an episode open to guests) gets a sign-in link.
    One level of replies: a reply form under each top-level comment, none under a reply. %>
<% rejected = @new_comment if @new_comment&.errors&.any? %>
<%# A rejected reply reopens its own reply form; one whose target has no reply form (a crafted reply to a reply, or
    to a comment deleted meanwhile) shows its reason on the main form instead, so it's never silently lost. %>
<% reply_targets = @comment_threads.filter_map { |comment, _| comment.id if comment.visible? } %>
<% top_rejected = rejected if rejected && !reply_targets.include?(rejected.parent_id) %>
<%# Handoff 0084 R2 (D-010) -- dark like the episode page around it; content and behavior unchanged. %>
<%# Handoff 0105 -- closer on phones (28px above, 24px inside the rule); sm and up as before. %>
<section id="comments" class="mt-7 scroll-mt-24 border-t border-line/10 pt-6 sm:mt-12 sm:pt-8">
  <h2 class="text-lg font-bold text-ink">댓글 <span class="text-ink-3"><%= @comment_count %></span></h2>

  <% if user_signed_in? %>
    <%= render "product_lines/comment_form", comment: top_rejected || EpisodeComment.new %>
  <% else %>
    <p class="mt-3 rounded-lg bg-card px-4 py-3 text-sm text-ink-2">
      <%= link_to "로그인하고 댓글 쓰기", new_user_session_path, class: "font-bold text-accent-ink hover:underline" %>
    </p>
  <% end %>

  <% if @comment_threads.empty? %>
    <p class="mt-6 text-sm text-ink-3">첫 댓글을 남겨 보세요.</p>
  <% else %>
    <ol class="mt-6 divide-y divide-line/10">
      <% @comment_threads.each do |comment, replies| %>
        <li>
          <%= render "product_lines/comment", comment: comment %>
          <% replies.each do |reply| %>
            <%= render "product_lines/comment", comment: reply %>
          <% end %>
          <% if user_signed_in? && comment.visible? %>
            <% reply_rejected = rejected if rejected&.parent_id == comment.id %>
            <details class="mb-3 ml-6 sm:ml-8" <%= "open" if reply_rejected %>>
              <summary class="cursor-pointer select-none text-xs font-semibold text-ink-3 hover:text-accent-ink">답글</summary>
              <%= render "product_lines/comment_form", comment: reply_rejected || EpisodeComment.new, parent: comment %>
            </details>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
