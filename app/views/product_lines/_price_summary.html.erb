<%# Handoff 0059 -- information only, deliberately no buy/start button: the Season page's purchase box stays
    the one place to act. `seasons` are the listed Seasons a visitor could get right now (ProductSeason#acquirable?),
    so a stopped/draft/private Season never shows up here; with none, nothing renders at all.
    Shown identically to every viewer (guest, signed-in, license holder) -- it describes the product, not the viewer,
    and never decides access. %>
<% if seasons.any? %>
  <% cheapest = seasons.min_by(&:price) %>
  <section id="price-summary" aria-label="가격 요약" class="mt-8 rounded-2xl border border-gray-200 bg-gray-50 p-5">
    <p class="text-xs font-bold uppercase tracking-wide text-blue-600">가격</p>
    <% if seasons.one? %>
      <p class="mt-1 text-xl font-black text-gray-900">
        <%= cheapest.season_code %> · <%= season_price_text(cheapest) %> · 무기한 이용
        <% unless cheapest.free? %><span class="text-sm font-semibold text-gray-500">(VAT 포함)</span><% end %>
      </p>
    <% else %>
      <p class="mt-1 text-xl font-black text-gray-900">
        최저 <%= season_price_text(cheapest) %> · <%= cheapest.season_code %> · 무기한 이용
        <% unless cheapest.free? %><span class="text-sm font-semibold text-gray-500">(VAT 포함)</span><% end %>
      </p>
      <p class="mt-1 text-sm text-gray-600">이용 가능한 Season <%= seasons.size %>개 · Season마다 따로 구매합니다.</p>
    <% end %>
  </section>
<% end %>
