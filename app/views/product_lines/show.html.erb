<%# Handoff 0083 R2 -- dark like the home and the series list ("browse" pages are dark); the shared partials get
    `dark: true` (their admin-preview use stays light). Only colors and fonts changed; content and links are the same. %>
<% content_for :title, "#{@product_line.customer_name} | LEEDOX" %>
<% content_for :color_scheme, "dark" %><%# Handoff 0100 -- a dark page (FrameThemeHelper#body_class) %>
<% content_for :head do %>
  <%= render "shared/display_font" %>
<% end %>
<div class="min-h-screen bg-[#0e1014] text-[#f2efe8]">
  <%= render "shared/header", dark: true %>
  <%# Handoff 0094 A1 -- no "← 가이드 목록" line any more (the header's 가이드 goes there); 0068 put it here. %>
  <%# 0094 A2/A3 -- 10px side and top margins on phones. %>
  <main class="mx-auto max-w-3xl px-2.5 pb-12 pt-2.5 sm:px-7 sm:pt-6">
    <%# Handoff 0091 (D-011) -- the season label (series_label, e.g. "S01") above the name is no longer shown. %>
    <%# Handoff 0065 -- the product is the sellable unit, so what used to be the Season page (purchase box,
        episode list, files) is part of this page. Handoff 0066: the access banner sits right under the cover image
        (inside the info block, which owns the cover), for every product. %>
    <%# Handoff 0090 -- section_nav: the sticky 소개 · 에피소드 links under the purchase box. %>
    <%= render "product_lines/info", product_line: @product_line, dark: true,
      purchase: { owned: @owned, for_sale: @for_sale, offer: @offer, free: @free, free_open: @free_open, open_episode: @first_open_episode },
      section_nav: series_section_nav_items(@product_line, @episodes, @upcoming_episodes) %>

    <%= render "product_lines/episode_list", episodes: @episodes, product_line: @product_line, upcoming_episodes: @upcoming_episodes, dark: true,
      cta_for: ->(episode) { episode_card_cta(episode, full_access: @full_episode_access, signed_in: user_signed_in?, free: @free) } %>

    <% if @assets_by_episode.any? %>
      <section class="mt-12">
        <h2 class="text-lg font-bold text-[#f2efe8]">산출물</h2>
        <div class="mt-4 space-y-3">
          <% @episodes.each do |episode| %>
            <% (@assets_by_episode[episode.id] || []).each do |asset| %>
              <div class="flex flex-col gap-3 rounded-xl border border-white/10 bg-[#15181e] p-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                  <p class="text-xs font-bold uppercase tracking-wide text-[#f0a53c]"><%= asset.kind %> · <%= episode.customer_title.presence || "(제목 없음)" %></p>
                  <p class="mt-1 font-bold text-[#f2efe8]"><%= asset.title %></p>
                  <% if asset.description.present? %><p class="mt-1 text-sm text-[#c9c4ba]"><%= asset.description %></p><% end %>
                  <p class="mt-1 truncate text-xs text-[#a8a39a]"><%= asset.file.filename %> · <%= number_to_human_size(asset.file.byte_size) %></p>
                </div>
                <%= link_to "다운로드", product_episode_asset_path(@product_line.slug, episode.display_id, asset.id),
                  class: "inline-flex flex-shrink-0 items-center justify-center rounded-lg bg-[#f0a53c] px-4 py-2 text-sm font-bold text-[#0e1014] hover:bg-[#f5b85e]" %>
              </div>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  </main>

  <%= render "shared/footer" %>
</div>
