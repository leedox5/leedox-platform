<%# Product Hero as one vertical flow, same order on every screen size:
    name -> (one-line summary) -> cover image (if any) -> free-form introduction (handoff 0060) -> AI supporter.
    Shared by the customer page and the admin preview; admin: true only changes which image URL is used.
    Without a cover the text follows the name (or the summary) directly (no empty media area).
    Handoff 0066: the customer page passes `purchase` (the locals of the access banner) and the banner is rendered
    right under the cover image (or under the name/summary when there is none); the admin preview passes none.
    Handoff 0069: `summary` (handoff 0068) is a subtitle right under the name -- plain text (no Markdown), and
    the element is skipped entirely when blank so a product without one keeps the exact old order/layout.
    Handoff 0069 R2: the "소개" heading duplicated the new summary with no added information, so it's sr-only now
    (kept, not deleted, so the heading structure -- h1 name -> h2 소개 -> the copy's own h3s... -- still holds for
    a screen reader); the body's own top margin is bumped to keep roughly the same visual gap the heading used to
    create between it and whatever sits above (the purchase box, or the image/summary when there's no box). %>
<%# Handoff 0083 R2 -- `dark: true` (the customer page) uses the dark palette from SeriesThemeHelper; the admin preview
    passes nothing and keeps its exact classes. %>
<% admin = local_assigns.fetch(:admin, false) %>
<% purchase = local_assigns[:purchase] %>
<% dark = local_assigns.fetch(:dark, false) %>
<%# Handoff 0093 -- whether an image is drawn below: the very branches below (the admin preview always draws one --
    the cover or the labelled placeholder; the customer page only an attached cover). Without one, the customer page
    puts the name, the summary and the access box into one header box (the box's own contents, below a thin rule) --
    only when there is an access box to put in (a guide without a commerce product has none, and stays as it was).
    break-keep: lines break between words, not mid-word (break-words still wraps a single overlong word). %>
<%# Handoff 0095 -- a guide WITH a cover gets the header box too (customer page, when there's an access box): the
    cover is the box's top, edge to edge (cut round by the box's corners), and the text below has the same padding as
    the box without a cover. Same checks as 0093; the box without a cover is unchanged. The admin preview keeps its own
    image block, and a guide without an access box keeps the old layout. %>
<% cover = !admin && product_line.cover_image.attached? %>
<% header_box = !admin && purchase.present? && product_line.access_state(owned: purchase[:owned]).present? %>
<% heading = capture do %>
  <h1 class="break-words break-keep font-bold <%= series_theme(:name_size, dark) %> <%= series_theme(:name, dark) %>"><%= product_line.customer_name %></h1>

  <% if product_line.summary.present? %>
    <p class="<%= series_theme(:summary_size, dark) %> break-words break-keep <%= series_theme(:summary, dark) %>"><%= product_line.summary %></p>
  <% end %>
<% end %>

<% if header_box && cover %>
  <div class="overflow-hidden rounded-2xl border <%= series_theme(:box, dark) %>" data-guide-header data-guide-cover>
    <%= render "product_lines/cover_image", product_line: product_line, variant: :hero, admin: false,
      classes: "block aspect-video w-full max-w-full bg-tint/5 object-cover" %>
    <div class="p-3.5 sm:px-6 sm:py-7">
      <%= heading %>
      <%= render "product_lines/purchase_box", product_line: product_line, dark: dark, bare: true, **purchase %>
    </div>
  </div>
<% elsif header_box %>
  <%# 0094 A4 -- 14px inside on phones. %>
  <div class="rounded-2xl border <%= series_theme(:box, dark) %> p-3.5 sm:px-6 sm:py-7" data-guide-header>
    <%= heading %>
    <%= render "product_lines/purchase_box", product_line: product_line, dark: dark, bare: true, **purchase %>
  </div>
<% else %>
  <%= heading %>
<% end %>

<% if admin %>
  <%# Admin preview only: the image itself (this page is the destination of the list/edit links); a product without a cover shows the shared placeholder so the
      layout is the same, clearly labelled -- the customer page never shows the placeholder. %>
  <div class="mt-6 min-w-0">
    <%= render "admin/product_lines/cover_link", product_line: product_line, variant: :hero, caption: true, link: false %>
  </div>
<% elsif cover && !header_box %>
  <%# 0094 -- closer on phones (the customer page only). %>
  <div class="mt-3 min-w-0 sm:mt-6">
    <%= render "product_lines/cover_image", product_line: product_line, variant: :hero, admin: false %>
  </div>
<% end %>

<% if purchase && !header_box %>
  <%= render "product_lines/purchase_box", product_line: product_line, dark: dark, **purchase %>
<% end %>
<%# Handoff 0090 -- the customer page passes `section_nav` (the 소개 / 에피소드 links), right under the purchase box. %>
<% if local_assigns[:section_nav].present? %>
  <%= render "product_lines/section_nav", items: section_nav %>
<% end %>

<div class="<%= series_theme(:body_gap, dark) %> space-y-6 break-words <%= series_theme(:body, dark) %>">
  <% if series_intro_section?(product_line) %>
  <%# Handoff 0090 -- #intro is a permanent address; scroll-mt keeps the first line clear of the header + section links. %>
  <div id="<%= ProductLinesHelper::SERIES_SECTION_IDS[:intro] %>" class="scroll-mt-28">
    <h2 class="sr-only">소개</h2>
    <%# Restricted Markdown (handoff 0063): hard line breaks keep the plain text of handoff 0060 looking as it did;
        images resolve only to this product's own images (admin preview points at the admin-only image route).
        Handoff 0066: a real section heading (h2, 24px) instead of a small blue label, and a reading-width column;
        line height is already 1.75 via `.doc-content p` (leading-7). %>
    <div class="<%= series_theme(:intro, dark) %> <%= series_theme(:intro_gap, dark) %> max-w-[740px] [&_p]:mb-4 [&>:last-child]:mb-0"><%= ContentMarkdown.render(product_line.introduction, parent: product_line, profile: :marketing, admin: admin) %></div>
  </div>
  <% end %>
  <% if product_line.ai_supporter.present? %>
    <div>
      <%# Same heading as 소개 (handoff 0066). %>
      <h2 class="text-2xl font-bold <%= series_theme(:heading, dark) %>">AI 서포터</h2>
      <p class="mt-3"><%= product_line.ai_supporter %></p>
    </div>
  <% end %>
</div>
