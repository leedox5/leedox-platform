<% content_for :title, "새 Takeaway" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950">새 Takeaway</h1>
      <%= link_to "← 편으로", edit_admin_content_episode_path(@episode), class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= form_with model: @takeaway, url: admin_content_episode_content_takeaways_path(@episode), class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @takeaway.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @takeaway.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <%= f.label :kind, "종류 (자유 서술, 예: 체크리스트/프롬프트)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :kind, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :body, "본문 (Markdown)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :body, rows: 8, class: "w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm" %>
      </div>

      <div>
        <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <%= f.submit "추가", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </main>
</div>
