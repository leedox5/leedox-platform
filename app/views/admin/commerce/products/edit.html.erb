<% content_for :title, "#{@product.name} 요금 및 설정 수정" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Admin Commerce</p>
        <h1 class="mt-2 text-3xl font-black text-slate-950"><%= @product.name %> 요금 및 설정 수정</h1>
        <p class="mt-2 text-slate-600">코드 배포나 시딩 없이 런타임 요금, 할인율 및 체험 한도를 직접 저장합니다.</p>
      </div>
      <%= link_to "← 목록으로 돌아가기", admin_commerce_products_path, class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= form_with model: @product, url: admin_commerce_product_path(@product), method: :patch, class: "mt-8 space-y-8" do |f| %>
      <!-- 기본 정보 및 판매 상태 -->
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6">
        <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">기본 상품 설정</h2>
        
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <%= f.label :name, "상품명", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.text_field :name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
          </div>

          <div>
            <%= f.label :trial_chapter_limit, "무료 체험 챕터 제한 (개)", class: "block text-sm font-bold text-slate-700 mb-1" %>
            <%= f.number_field :trial_chapter_limit, min: 0, placeholder: "기본값 사용 시 비워둠", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none" %>
            <p class="mt-1 text-xs text-slate-500">체험 가능 유저에게 어디 챕터까지 접근을 허용할지 지정합니다.</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-6 pt-2">
          <label class="inline-flex items-center gap-2 cursor-pointer text-sm font-bold text-slate-800">
            <%= f.check_box :sale_enabled, class: "rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
            <span>판매 개시 (Sale Enabled)</span>
          </label>

          <label class="inline-flex items-center gap-2 cursor-pointer text-sm font-bold text-slate-800">
            <%= f.check_box :free_access, class: "rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
            <span>영구 무료 상품 (Free Access)</span>
          </label>

          <label class="inline-flex items-center gap-2 cursor-pointer text-sm font-bold text-slate-800">
            <%= f.check_box :active, class: "rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
            <span>상품 활성화 (Active)</span>
          </label>
        </div>
      </section>

      <!-- 요금제 설정 (1, 3, 6, 12개월) -->
      <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-3">기간별 동적 요금제 (ProductOffer)</h2>
        <p class="mt-2 text-xs text-slate-500">원하시는 이용 기간별 최종 결제 금액(VAT 포함 KRW)과 할인율(%)을 지정해 주세요.</p>

        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          <% [1, 3, 6, 12].each_with_index do |months, idx| %>
            <% offer = @product.product_offers.find { |o| o.duration_months == months } %>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5 space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="font-bold text-slate-900 text-base"><%= months %>개월 이용권</h3>
                <label class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 cursor-pointer">
                  <input type="hidden" name="product[offers_attributes][<%= idx %>][active]" value="0">
                  <input type="checkbox" name="product[offers_attributes][<%= idx %>][active]" value="1" <%= "checked" if offer&.active? %> class="rounded border-slate-300 text-blue-600">
                  <span>활성화</span>
                </label>
              </div>

              <input type="hidden" name="product[offers_attributes][<%= idx %>][duration_months]" value="<%= months %>">

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">최종 금액 (VAT 포함 원화)</label>
                <input type="number" name="product[offers_attributes][<%= idx %>][total_amount]" value="<%= offer&.total_amount || 0 %>" min="0" step="1" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-none">
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">할인율 (%)</label>
                <input type="number" name="product[offers_attributes][<%= idx %>][discount_pct]" value="<%= (offer&.discount_bps || 0) / 100.0 %>" min="0" max="100" step="0.01" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-900 focus:border-blue-500 focus:outline-none">
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <div class="flex justify-end gap-3 pt-4">
        <%= link_to "취소", admin_commerce_products_path, class: "rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50 transition" %>
        <%= f.submit "설정 저장하기", class: "rounded-xl bg-blue-600 px-8 py-3 text-sm font-bold text-white shadow-md hover:bg-blue-700 transition cursor-pointer" %>
      </div>
    <% end %>
  </main>
</div>
