<% content_for :title, "새 산출물 — #{@episode.customer_title}" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950">새 산출물 — <%= @episode.customer_title.presence || "(제목 없음)" %></h1>
      <%= link_to "← 편으로", edit_admin_content_episode_path(@episode), class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= render "form", asset: @asset, url: admin_content_episode_content_assets_path(@episode), method: :post, submit_label: "업로드" %>
  </main>
</div>
