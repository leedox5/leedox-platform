<%= form_with model: asset, url: url, method: method, multipart: true, class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
  <% if asset.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
      <%= asset.errors.full_messages.join(", ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "고객 표시 제목", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_field :title, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :kind, "종류", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_field :kind, placeholder: "예: 소스코드, 실행파일, 구현 스펙", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :description, "짧은 설명 (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_area :description, rows: 2, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    <p class="mt-1 text-xs text-slate-500">같은 편 안에서 겹치지 않는 숫자여야 합니다.</p>
  </div>

  <div>
    <%= f.label :file, (asset.persisted? ? "파일 교체 (선택)" : "파일"), class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.file_field :file, class: "block w-full text-sm text-slate-700" %>
    <% if asset.persisted? && asset.file.attached? %>
      <p class="mt-1 text-xs text-slate-500">
        현재 파일: <strong><%= asset.file.filename %></strong> (<%= number_to_human_size(asset.file.byte_size) %>).
        새 파일을 고르지 않으면 그대로 유지되고, 고르면 이전 파일은 삭제됩니다.
      </p>
    <% end %>
    <p class="mt-1 text-xs text-slate-500">
      허용 형식: <%= ContentAsset.allowed_extensions.join(", ") %> · 최대 <%= number_to_human_size(ContentAsset.max_file_size) %>.
      파일 이름은 화면 표시에만 쓰이며 저장 경로에는 쓰이지 않습니다.
    </p>
  </div>

  <%= f.submit submit_label, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
<% end %>
