<% content_for :title, "미리보기 — #{@episode.customer_title}" %>

<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-800">
      관리자 전용 미리보기 — 실제 고객 화면이 아니며, <%= @episode.status %> 상태 그대로 보입니다.
      <%= link_to "편집으로 돌아가기", edit_admin_content_episode_path(@episode), class: "ml-2 underline" %>
    </div>

    <p class="text-sm font-semibold uppercase tracking-wide text-blue-600">Chapter <%= @episode.position %></p>
    <h1 class="text-3xl font-bold text-gray-900"><%= @episode.customer_title.presence || "(제목 없음)" %></h1>

    <div class="doc-content mt-8 max-w-none">
      <%= sanitize(
        render_preview_markdown(@episode.body),
        tags: %w[h1 h2 h3 h4 h5 h6 p br hr ul ol li pre code blockquote strong em a img table thead tbody tr th td],
        attributes: %w[href target rel src alt]
      ) %>
    </div>

    <% if @takeaways.any? %>
      <div class="mt-10 space-y-4">
        <% @takeaways.each do |takeaway| %>
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700"><%= takeaway.kind %></p>
            <div class="doc-content mt-2 max-w-none text-sm">
              <%= sanitize(
                render_preview_markdown(takeaway.body),
                tags: %w[h1 h2 h3 h4 h5 h6 p br hr ul ol li pre code blockquote strong em a img table thead tbody tr th td],
                attributes: %w[href target rel src alt]
              ) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
