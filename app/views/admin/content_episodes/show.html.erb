<% content_for :title, "미리보기 — #{@episode.customer_title}" %>

<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-col gap-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-800 sm:flex-row sm:items-center sm:justify-between">
      <span>관리자 전용 미리보기 — 실제 고객 화면이 아니며, <%= @episode.status %> 상태 그대로 보입니다.</span>
      <%= link_to "편집으로 돌아가기", edit_admin_content_episode_path(@episode), class: "underline sm:flex-shrink-0" %>
    </div>

    <%# Product episodes use the new-product term; legacy Bundle episodes keep "Chapter" (handoff 0056 R4 follow-up) %>
    <p class="text-sm font-semibold uppercase tracking-wide text-blue-600"><%= @episode.product_line_id? ? "Episode" : "Chapter" %> <%= @episode.position %></p>
    <h1 class="text-3xl font-bold text-gray-900"><%= @episode.customer_title.presence || "(제목 없음)" %></h1>

    <div class="doc-content mt-8 max-w-none">
      <%= render_preview_markdown(@episode.body) %>
    </div>

    <% if @takeaways.any? %>
      <div class="mt-10 space-y-4">
        <% @takeaways.each do |takeaway| %>
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700"><%= takeaway.kind %></p>
            <div class="doc-content mt-2 max-w-none text-sm">
              <%= render_preview_markdown(takeaway.body) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @assets.present? %>
      <div class="mt-10 rounded-xl border border-slate-200 p-5">
        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">첨부 산출물 (관리자 미리보기 — 이 편의 상태와 무관하게 표시)</p>
        <ul class="mt-3 divide-y divide-slate-100">
          <% @assets.each do |asset| %>
            <li class="flex items-center justify-between gap-4 py-3">
              <div class="min-w-0">
                <p class="font-semibold text-gray-900"><span class="mr-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-700"><%= asset.kind %></span><%= asset.title %></p>
                <% if asset.description.present? %><p class="text-sm text-gray-600"><%= asset.description %></p><% end %>
                <p class="truncate text-xs text-gray-500"><%= asset.file.filename %> · <%= number_to_human_size(asset.file.byte_size) %></p>
              </div>
              <%= link_to "다운로드", download_admin_content_asset_path(asset), class: "flex-shrink-0 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mt-10 flex justify-between border-t border-gray-100 pt-8">
      <% if @prev_episode %>
        <%= link_to admin_content_episode_path(@prev_episode), class: "flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600" do %>
          <span>←</span>
          <span><%= @prev_episode.customer_title.presence || "(제목 없음)" %> <span class="text-xs text-gray-400">(<%= @prev_episode.status %>)</span></span>
        <% end %>
      <% else %>
        <div></div>
      <% end %>

      <% if @next_episode %>
        <%= link_to admin_content_episode_path(@next_episode), class: "flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600" do %>
          <span><%= @next_episode.customer_title.presence || "(제목 없음)" %> <span class="text-xs text-gray-400">(<%= @next_episode.status %>)</span></span>
          <span>→</span>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
