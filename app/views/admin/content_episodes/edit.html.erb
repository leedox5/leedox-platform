<% content_for :title, "편 편집 — #{@episode.customer_title}" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-950"><%= @episode.customer_title.presence || "(제목 없음)" %></h1>
        <p class="mt-1 text-sm text-slate-500">
          상태: <span class="font-bold"><%= @episode.status %></span>
          · 최종 수정: <%= l(@episode.updated_at, format: :long, locale: :ko) %>
          · revision <%= @episode.content_revisions.count %>건
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <%= link_to "← 묶음으로", edit_admin_content_bundle_path(@bundle), class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
        <%= link_to "관리자 미리보기 →", admin_content_episode_path(@episode), class: "text-sm font-bold text-blue-700 hover:underline" %>
      </div>
    </header>

    <div class="mt-4 flex gap-3">
      <% if @episode.published? %>
        <%= button_to "비공개로 전환", unpublish_admin_content_episode_path(@episode), method: :patch, class: "rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-bold text-amber-800 hover:bg-amber-100" %>
      <% else %>
        <%= button_to "게시하기", publish_admin_content_episode_path(@episode), method: :patch, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700" %>
      <% end %>
    </div>

    <% if flash[:alert] %>
      <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm font-semibold text-amber-800">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with model: @episode, url: admin_content_episode_path(@episode), method: :patch, class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @episode.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @episode.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <%= f.hidden_field :lock_version %>

      <div>
        <%= f.label :customer_title, "고객 노출 제목", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :customer_title, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :body, "본문 (Markdown)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :body, rows: 16, class: "w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm" %>
        <p class="mt-1 text-xs text-slate-500">본문을 바꾸고 저장하면 이전 내용이 revision으로 자동 기록됩니다.</p>
      </div>

      <%= f.submit "저장", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900">Takeaway</h2>
        <%= link_to "+ 추가", new_admin_content_episode_content_takeaway_path(@episode), class: "rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-bold text-white hover:bg-slate-900" %>
      </div>

      <ul class="mt-4 divide-y divide-slate-100">
        <% @takeaways.each do |takeaway| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="font-semibold text-slate-900"><%= takeaway.kind %></p>
              <p class="truncate text-xs text-slate-500"><%= takeaway.body %></p>
            </div>
            <%= link_to "편집", edit_admin_content_takeaway_path(takeaway), class: "flex-shrink-0 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
          </li>
        <% end %>
        <% if @takeaways.empty? %><p class="py-6 text-center text-slate-500">아직 takeaway가 없습니다.</p><% end %>
      </ul>
    </section>
  </main>
</div>
