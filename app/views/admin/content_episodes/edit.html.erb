<% content_for :title, "편 편집 — #{@episode.customer_title}" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-950"><%= @episode.customer_title.presence || "(제목 없음)" %></h1>
        <p class="mt-1 text-sm text-slate-500">
          상태: <span class="font-bold"><%= @episode.status %></span>
          · 최종 수정: <%= l(@episode.updated_at, format: :long, locale: :ko) %>
          · revision <%= @episode.content_revisions.count %>건
        </p>
      </div>
      <div class="flex flex-col items-end gap-2">
        <%= link_to "← #{parent_label}으로", parent_edit_path, class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
        <%= link_to "관리자 미리보기 →", admin_content_episode_path(@episode), class: "text-sm font-bold text-blue-700 hover:underline" %>
      </div>
    </header>

    <% status_labels = { "draft" => "draft로", "in_review" => "in_review로", "published" => "게시", "unpublished" => "비공개로" } %>
    <div class="mt-4 flex flex-wrap gap-3">
      <% Admin::ContentEpisodesController::VALID_STATUSES.without(@episode.status).each do |target| %>
        <%= button_to status_labels.fetch(target), transition_admin_content_episode_path(@episode, status: target), method: :patch,
          class: "rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50" %>
      <% end %>
    </div>

    <% if flash[:alert] %>
      <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm font-semibold text-amber-800">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with model: @episode, url: admin_content_episode_path(@episode), method: :patch, class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @episode.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @episode.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <%= f.hidden_field :lock_version %>

      <div>
        <%= f.label :customer_title, "고객 노출 제목", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :customer_title, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :body, "본문 (Markdown)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :body, rows: 16, class: "w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm" %>
        <p class="mt-1 text-xs text-slate-500">본문을 바꾸고 저장하면 이전 내용이 revision으로 자동 기록됩니다.</p>
      </div>

      <div>
        <%= f.label :internal_ref, "출처·관리자 메모 (고객에게 노출되지 않음)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :internal_ref, rows: 3, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">근거 원문 위치나 "이 본문은 축약 샘플" 같은 메모를 자유롭게 적을 수 있습니다. 고객용 화면·관리자 미리보기 어디에도 표시되지 않습니다.</p>
      </div>

      <%= f.submit "저장", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900">Takeaway</h2>
        <%= link_to "+ 추가", new_admin_content_episode_content_takeaway_path(@episode), class: "rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-bold text-white hover:bg-slate-900" %>
      </div>

      <ul class="mt-4 divide-y divide-slate-100">
        <% @takeaways.each do |takeaway| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="font-semibold text-slate-900"><%= takeaway.kind %></p>
              <p class="truncate text-xs text-slate-500"><%= takeaway.body %></p>
            </div>
            <%= link_to "편집", edit_admin_content_takeaway_path(takeaway), class: "flex-shrink-0 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
          </li>
        <% end %>
        <% if @takeaways.empty? %><p class="py-6 text-center text-slate-500">아직 takeaway가 없습니다.</p><% end %>
      </ul>
    </section>

    <% if @episode.product_season_id? %>
      <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900">첨부 산출물</h2>
          <%= link_to "+ 업로드", new_admin_content_episode_content_asset_path(@episode), class: "flex-shrink-0 whitespace-nowrap rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-bold text-white hover:bg-slate-900" %>
        </div>
        <p class="mt-1 text-xs text-slate-500">고객이 내려받는 파일입니다. 이 편이 게시되면 함께 공개됩니다.</p>

        <ul class="mt-4 divide-y divide-slate-100">
          <% @episode.content_assets.ordered.with_attached_file.each do |asset| %>
            <li class="flex flex-col gap-3 py-3 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="font-semibold text-slate-900">
                  <span class="mr-2 text-xs font-normal text-slate-400"><%= asset.position %></span>
                  <span class="mr-2 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-700"><%= asset.kind %></span>
                  <%= asset.title %>
                </p>
                <p class="truncate text-xs text-slate-500"><%= asset.file.filename %> · <%= number_to_human_size(asset.file.byte_size) %></p>
              </div>
              <div class="flex flex-shrink-0 items-center gap-2">
                <%= link_to "다운로드", download_admin_content_asset_path(asset), class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
                <%= link_to "편집", edit_admin_content_asset_path(asset), class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
                <%= button_to "삭제", admin_content_asset_path(asset), method: :delete,
                  data: { turbo_confirm: "\"#{asset.title}\" (#{asset.file.filename}) 산출물을 정말 삭제하시겠습니까? 실제 파일도 함께 삭제되며 되돌릴 수 없습니다." },
                  form_class: "inline", class: "rounded-lg border border-red-300 bg-white px-3 py-1.5 text-xs font-bold text-red-700 hover:bg-red-50" %>
              </div>
            </li>
          <% end %>
          <% if @episode.content_assets.none? %><p class="py-6 text-center text-slate-500">아직 첨부한 산출물이 없습니다.</p><% end %>
        </ul>
      </section>
    <% end %>

    <section class="mt-8 rounded-2xl border-2 border-red-200 bg-red-50 p-6">
      <h2 class="text-lg font-bold text-red-900">위험 영역</h2>
      <p class="mt-1 text-sm text-red-800">
        이 편을 삭제하면 연결된 takeaway와 revision 이력<%= ", 첨부 산출물(파일 포함)".html_safe if @episode.product_season_id? %>도 함께 삭제됩니다. archived나 휴지통 같은
        복구 수단은 없습니다 — 되돌릴 수 없습니다. 다른 편의 원고·상태·순서는 바뀌지 않습니다.
        <% if @episode.published? %>
          <strong>이 편은 현재 게시 중입니다 — 삭제하면 고객 URL이 즉시 사라집니다.</strong>
        <% end %>
      </p>
      <% episode_title = @episode.customer_title.presence || "(제목 없음)" %>
      <% confirm_message = +"\"#{episode_title}\" 편을 정말 삭제하시겠습니까? 되돌릴 수 없습니다." %>
      <% confirm_message << " 이 편은 현재 게시 중이며, 삭제하면 고객 URL이 즉시 사라집니다." if @episode.published? %>
      <%= button_to "편 삭제", admin_content_episode_path(@episode), method: :delete,
        data: { turbo_confirm: confirm_message },
        class: "mt-4 rounded-lg border-2 border-red-400 bg-red-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-red-700" %>
    </section>
  </main>
</div>
