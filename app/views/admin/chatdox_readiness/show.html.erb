<% content_for :head do %><meta name="robots" content="noindex,nofollow"><% end %>

<main class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6">
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 pb-6">
    <div>
      <p class="text-sm font-bold uppercase text-blue-700">Admin Readiness</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-950">CHATDOX release readiness</h1>
    </div>
    <%= link_to "관리자 대시보드", admin_dashboard_path, class: "text-sm font-bold text-blue-700 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" %>
  </div>

  <section class="py-7" aria-labelledby="release-state-heading">
    <h2 id="release-state-heading" class="text-lg font-bold text-slate-950">Release state</h2>
    <dl class="mt-4 grid gap-x-8 gap-y-5 border-y border-slate-200 py-5 sm:grid-cols-2 lg:grid-cols-4">
      <div><dt class="text-xs font-bold uppercase text-slate-500">State</dt><dd class="mt-1 font-mono font-bold"><%= @readiness.state %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Reason</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.reason %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Source mode</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.source_mode %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Canonical routes</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.canonical_routes ? "open" : "blocked" %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Expected commit</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.expected_commit || "not configured" %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Installed commit</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.installed_commit || "not installed" %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Schema</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.schema_version || "unknown" %></dd></div>
      <div><dt class="text-xs font-bold uppercase text-slate-500">Progress inventory</dt><dd class="mt-1 font-mono text-sm"><%= @readiness.progress_inventory.to_s.tr("_", " ") %></dd></div>
    </dl>
  </section>

  <section class="py-6" aria-labelledby="season-readiness-heading">
    <h2 id="season-readiness-heading" class="text-lg font-bold text-slate-950">Public catalog</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[34rem] border-collapse text-left text-sm">
        <thead><tr class="border-b border-slate-300"><th class="py-3">Season</th><th>Status</th><th>Public episodes</th></tr></thead>
        <tbody><% @readiness.seasons.each do |season| %><tr class="border-b border-slate-200"><td class="py-3 font-mono"><%= season[:code] %></td><td><%= season[:status] %></td><td><%= season[:public_episode_count] %></td></tr><% end %></tbody>
      </table>
    </div>
  </section>

  <section class="py-6" aria-labelledby="diagnostics-heading">
    <h2 id="diagnostics-heading" class="text-lg font-bold text-slate-950">Diagnostics</h2>
    <% if @readiness.diagnostics.empty? %>
      <p class="mt-3 text-sm text-slate-600">No diagnostics.</p>
    <% else %>
      <ul class="mt-3 divide-y divide-slate-200 border-y border-slate-200">
        <% @readiness.diagnostics.each do |item| %><li class="flex justify-between gap-4 py-3 font-mono text-sm"><span><%= item[:severity] %> · <%= item[:code] %></span><span><%= item[:count] %></span></li><% end %>
      </ul>
    <% end %>
  </section>
</main>
