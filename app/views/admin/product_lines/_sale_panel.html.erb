<%# 판매 설정 (handoff 0057; per product line since 0065): one-time price + sale switch for this product. %>
<% product = product_line.product %>
<% offer = product_line.lifetime_offer %>
<% on_sale = product&.sale_enabled? %>
<% owners = product ? product.licenses.not_canceled.count : 0 %>
<% free = product_line.free? %>
<section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" id="sale-settings">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-lg font-bold text-slate-900">판매 설정</h2>
    <span class="rounded-full px-3 py-1 text-xs font-bold <%= on_sale ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-700" %>">
      <%= product.nil? ? "판매 설정 없음 (무료 공개)" : (free ? (on_sale ? "무료 이용 시작 가능" : "무료 · 시작 중지") : (on_sale ? "판매 중" : "판매 중지")) %>
    </span>
  </div>

  <% unless Commerce::Sales.globally_enabled? %>
    <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs font-semibold text-amber-800">
      전역 판매 스위치(<code>LEEDOX_COMMERCE_ENABLED</code>)가 꺼져 있어, 이 화면에서 판매를 시작해도 이 환경에서는 유료 구매가 열리지 않습니다. (0원 무료 제품의 이용 시작은 결제가 없어 이 스위치와 무관합니다.)
    </p>
  <% end %>

  <p class="mt-3 text-xs text-slate-500">
    가격은 이 제품 하나에만 적용되는 <strong>일회 결제·무기한 이용</strong> 가격입니다. 같은 시리즈의 다른 제품은 함께 열리지 않습니다.
    <strong>0원</strong>으로 저장하면 무료 제품이 되어, 주문·결제 없이 고객이 <strong>"무료로 이용 시작"</strong> 버튼으로 시작합니다(판매 시작을 눌러야 열립니다). 유료 ↔ 무료(0원)로 바꾸면 안전을 위해 판매가 자동으로 중지됩니다.
    판매 중지는 <strong>신규 구매만</strong> 막고 이미 구매한 분의 이용은 유지됩니다. 환불이 승인되면 그 주문의 이용권만 회수됩니다.
  </p>

  <%= form_with url: admin_product_line_sale_path(product_line), method: :patch, scope: :sale, class: "mt-5 flex flex-wrap items-end gap-3" do |f| %>
    <div>
      <%= f.label :total_amount, "가격 (원, VAT 포함)", class: "block text-sm font-bold text-slate-700 mb-1" %>
      <%= f.number_field :total_amount, value: offer&.total_amount, min: 0, step: 1, required: true, class: "w-48 rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <%= f.submit "가격 저장", class: "cursor-pointer whitespace-nowrap rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700",
      data: (product ? {} : { turbo_confirm: "가격을 저장하면 이 제품의 편과 산출물은 구매자만 이용할 수 있게 됩니다. (현재 공개 중이라면 비구매자는 더 이상 볼 수 없습니다.) 판매는 중지 상태로 시작합니다. 계속할까요?" }) %>
  <% end %>

  <% if offer %>
    <dl class="mt-4 grid gap-x-6 gap-y-1 text-xs text-slate-600 sm:grid-cols-2">
      <div><dt class="inline font-bold">저장된 가격</dt> <dd class="inline"><%= free ? "무료 (0원)" : "#{number_with_delimiter(offer.total_amount)}원 (공급가 #{number_with_delimiter(offer.supply_amount)} + VAT #{number_with_delimiter(offer.vat_amount)})" %></dd></div>
      <div><dt class="inline font-bold">내부 상품 코드</dt> <dd class="inline"><code><%= product.code %></code></dd></div>
      <div><dt class="inline font-bold">유효 이용권</dt> <dd class="inline"><%= owners %>건<%= " (무료 시작 포함)" if free %></dd></div>
    </dl>

    <div class="mt-5 flex flex-wrap gap-3">
      <% if on_sale %>
        <%= button_to (free ? "무료 시작 중지" : "판매 중지"), stop_admin_product_line_sale_path(product_line), method: :patch,
          data: { turbo_confirm: (free ? "무료 이용 시작을 중지할까요? 새로 시작하는 것만 막히고 이미 시작한 분(#{owners}건)의 이용은 유지됩니다." : "판매를 중지할까요? 신규 구매만 막히고 기존 구매자(#{owners}건)의 이용은 유지됩니다.") },
          class: "whitespace-nowrap rounded-lg border-2 border-red-300 bg-white px-4 py-2 text-sm font-bold text-red-700 hover:bg-red-50" %>
      <% else %>
        <%= button_to (free ? "무료 이용 시작 열기" : "판매 시작"), start_admin_product_line_sale_path(product_line), method: :patch,
          data: { turbo_confirm: (free ? "이 제품을 무료로 공개할까요? 로그인한 고객이 결제 없이 이용을 시작할 수 있게 됩니다." : "#{number_with_delimiter(offer.total_amount)}원(VAT 포함)에 판매를 시작할까요? 고객이 실제로 구매할 수 있게 됩니다.") },
          class: "whitespace-nowrap rounded-lg bg-emerald-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-emerald-700" %>
      <% end %>
    </div>
  <% end %>
</section>
