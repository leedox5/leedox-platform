<% content_for :title, "새 제품" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950">새 제품</h1>
      <%= link_to "← 목록으로", admin_product_lines_path, class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= form_with model: @product_line, multipart: true, url: admin_product_lines_path, class: "mt-8 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @product_line.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @product_line.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <%= f.label :internal_name, "내부 관리명", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :internal_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :customer_name, "고객용 제품명", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :customer_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">AI 이름보다 고객 문제·결과가 먼저 드러나는 이름을 권장합니다.</p>
      </div>

      <div>
        <%= f.label :summary, "한줄요약 (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :summary, placeholder: "예: WSL 위에서 오래된 Java 웹앱을 다시 실행하는 방법", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">제품 목록 카드에 표시됩니다. 비워 두면 그 줄이 빠집니다. 권장 길이 60자 안팎(강제하지 않습니다).</p>
      </div>

      <div>
        <%= f.label :slug, "고객 URL slug", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :slug, placeholder: "예: codex-todo", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono" %>
        <p class="mt-1 text-xs text-slate-500">소문자·숫자·하이픈만. 고객 URL: <code>/products/&lt;slug&gt;</code></p>
      </div>

      <div>
        <%= f.label :introduction, "소개", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :introduction, rows: 10, placeholder: "이 제품이 어떤 문제를 풀고, 무엇을 얻게 되며, 누구를 위한 것인지 자유롭게 적어 주세요", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">자유롭게 적으세요. 줄바꿈은 그대로 표시되고 마크다운은 적용되지 않습니다.</p>
      </div>

      <div>
        <%= f.label :ai_supporter, "AI 서포터 (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :ai_supporter, placeholder: "예: Codex", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <%= render "admin/product_lines/cover_fields", f: f %>

      <%= f.submit "만들기", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </main>
</div>
