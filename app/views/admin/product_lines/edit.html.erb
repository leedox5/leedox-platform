<% content_for :title, "#{@product_line.customer_name} 편집" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950"><%= @product_line.customer_name %></h1>
      <div class="flex flex-col items-end gap-2">
        <%= link_to "← 목록으로", admin_product_lines_path, class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
        <%= link_to "관리자 미리보기 →", admin_product_line_path(@product_line), class: "text-sm font-bold text-blue-700 hover:underline" %>
        <% if @product_line.published? %>
          <%= link_to "고객 화면 보기 →", product_line_path(@product_line.slug), class: "text-sm font-bold text-blue-700 hover:underline", target: "_blank", rel: "noopener" %>
        <% end %>
      </div>
    </header>

    <div data-controller="markdown-editor" data-markdown-editor-url-value="<%= admin_markdown_preview_path %>" data-markdown-editor-parent-type-value="product_line" data-markdown-editor-parent-id-value="<%= @product_line.id %>">
    <%= form_with model: @product_line, multipart: true, url: admin_product_line_path(@product_line), method: :patch, class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @product_line.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @product_line.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <%= f.label :internal_name, "내부 관리명", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :internal_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :customer_name, "고객용 제품명", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :customer_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :slug, "고객 URL slug", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :slug, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono" %>
        <p class="mt-1 text-xs text-slate-500">고객 URL: <code><%= product_line_path(@product_line.slug) %></code></p>
      </div>

      <div>
        <%= f.label :introduction, "소개", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_area :introduction, rows: 10, data: { markdown_editor_target: "textarea" }, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">마크다운을 쓸 수 있습니다: <code>**굵게**</code>, <code>- 목록</code>, <code>[글자](https://…)</code>. 줄바꿈은 그대로 표시됩니다. 원본 HTML은 글자 그대로 보이고, 이미지는 아래에서 올린 것만 <code>![설명](image:ID)</code> 로 넣을 수 있습니다.</p>
        <div class="mt-2 flex items-center gap-2">
          <button type="button" data-action="markdown-editor#preview" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50">미리보기</button>
          <button type="button" data-action="markdown-editor#closePreview" class="text-xs font-bold text-slate-500 hover:text-slate-800">미리보기 닫기</button>
        </div>
        <div data-markdown-editor-target="preview" hidden class="mt-3 rounded-xl border border-slate-200 bg-white p-4"></div>

      </div>

      <div>
        <%= f.label :ai_supporter, "AI 서포터 (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :ai_supporter, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :status, "공개 상태", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.select :status, ProductLine::STATUSES, {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">published가 아니면 slug를 알아도 고객 URL에서 보이지 않습니다.</p>
      </div>

      <div>
        <%= f.label :visibility, "공개 범위", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.select :visibility, ProductLine::VISIBILITIES, {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">public·unlisted는 URL로 열립니다(unlisted는 목록에 나오지 않음). private은 관리자만 볼 수 있습니다. 구매 가능 여부와는 무관합니다.</p>
      </div>

      <fieldset class="space-y-3 rounded-xl border border-slate-200 p-4">
        <legend class="px-2 text-sm font-bold text-slate-700">시리즈 (선택)</legend>
        <p class="text-xs text-slate-500">같은 시리즈로 묶을 제품끼리 같은 키를 적습니다. 비워 두면 독립 제품입니다. 시리즈 화면은 아직 없고, 키·이름·순서만 저장됩니다.</p>
        <div class="grid gap-3 sm:grid-cols-3">
          <div>
            <%= f.label :series_key, "시리즈 키", class: "block text-xs font-bold text-slate-600 mb-1" %>
            <%= f.text_field :series_key, placeholder: "예: was-core", class: "w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm" %>
          </div>
          <div>
            <%= f.label :series_label, "표시 이름", class: "block text-xs font-bold text-slate-600 mb-1" %>
            <%= f.text_field :series_label, placeholder: "예: 시즌1", maxlength: 40, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= f.label :series_position, "순서", class: "block text-xs font-bold text-slate-600 mb-1" %>
            <%= f.number_field :series_position, min: 0, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
          </div>
        </div>
      </fieldset>

      <%= render "admin/product_lines/cover_fields", f: f %>

      <%= f.submit "저장", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>

    <%= render "admin/content_images/panel", parent: @product_line %>
    </div>

    <%= render "admin/product_lines/sale_panel", product_line: @product_line %>

    <% if @product_line.persisted? && ProductLine.find(@product_line.id).cover_image.attached? %>
      <% stored_cover = ProductLine.find(@product_line.id).cover_image %>
      <section class="mt-8 rounded-2xl border-2 border-red-200 bg-red-50 p-6">
        <h2 class="text-lg font-bold text-red-900">대표 이미지 삭제</h2>
        <p class="mt-1 text-sm text-red-800">
          대표 이미지 파일을 삭제하면 저장된 원본과 표시용 이미지가 함께 삭제되고 되돌릴 수 없습니다.
          삭제 후 고객 화면은 텍스트 Hero로 표시됩니다. 제품 정보와 편은 바뀌지 않습니다.
        </p>
        <%= button_to "대표 이미지 삭제", admin_product_line_cover_path(@product_line), method: :delete,
          data: { turbo_confirm: "\"#{@product_line.customer_name}\"의 대표 이미지 #{stored_cover.filename}을(를) 정말 삭제하시겠습니까? 저장된 파일이 함께 삭제되며 되돌릴 수 없습니다." },
          class: "mt-4 rounded-lg border-2 border-red-400 bg-red-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-red-700" %>
      </section>
    <% end %>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" id="episodes">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900">편</h2>
        <%= link_to "+ 새 편", new_admin_product_line_content_episode_path(@product_line), class: "flex-shrink-0 whitespace-nowrap rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-bold text-white hover:bg-slate-900" %>
      </div>

      <ul class="mt-4 divide-y divide-slate-100">
        <% @episodes.each do |episode| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900"><%= episode.display_id %> — <%= episode.customer_title.presence || "(제목 없음)" %></p>
              <p class="text-xs text-slate-500"><%= episode.status %></p>
            </div>
            <div class="flex flex-shrink-0 gap-2">
              <%= link_to "미리보기", admin_content_episode_path(episode), class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
              <%= link_to "편집", edit_admin_content_episode_path(episode), class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
            </div>
          </li>
        <% end %>
        <% if @episodes.empty? %><p class="py-6 text-center text-slate-500">아직 편이 없습니다.</p><% end %>
      </ul>
    </section>
  </main>
</div>
