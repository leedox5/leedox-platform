<% content_for :title, "미리보기 — #{@product_line.customer_name}" %>

<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-5 py-10 sm:px-7">
    <div class="mb-6 flex flex-col gap-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-800 sm:flex-row sm:items-center sm:justify-between">
      <span>관리자 전용 미리보기 — 실제 고객 화면이 아니며, 제품은 <%= @product_line.status %> · <%= @product_line.visibility %> 상태 그대로 보입니다.</span>
      <%= link_to "편집으로 돌아가기", edit_admin_product_line_path(@product_line), class: "underline sm:flex-shrink-0" %>
    </div>

    <%= render "product_lines/info", product_line: @product_line, admin: true %>

    <ol class="mt-10 space-y-3">
      <% @episodes.each do |episode| %>
        <li><%= render "product_lines/episode_card", episode: episode, path: admin_content_episode_path(episode), admin: true %></li>
      <% end %>
      <% if @episodes.empty? %><p class="text-gray-500">아직 편이 없습니다.</p><% end %>
    </ol>
  </main>
</div>
