<% content_for :title, "미리보기 — #{@product_line.customer_name}" %>

<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-5 py-10 sm:px-7">
    <div class="mb-6 flex flex-col gap-2 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm font-bold text-blue-800 sm:flex-row sm:items-center sm:justify-between">
      <span>관리자 전용 미리보기 — 실제 고객 화면이 아니며, 제품은 <%= @product_line.status %> 상태 그대로 보입니다.</span>
      <%= link_to "편집으로 돌아가기", edit_admin_product_line_path(@product_line), class: "underline sm:flex-shrink-0" %>
    </div>

    <%= render "product_lines/info", product_line: @product_line, admin: true %>

    <section class="mt-10">
      <h2 class="text-lg font-bold text-gray-900">Season</h2>
      <div class="mt-4 space-y-3">
        <% @seasons.each do |season| %>
          <div class="rounded-xl border border-gray-200 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">
              <%= season.season_code %> <span class="ml-1 font-normal normal-case text-gray-400">(<%= season.status %> · <%= season.visibility %>)</span>
            </p>
            <p class="mt-1 font-bold text-gray-900"><%= season.display_title %></p>
            <%= link_to "Season 미리보기 →", admin_product_season_path(season), class: "mt-2 inline-block text-sm font-bold text-blue-700 hover:underline" %>
          </div>
        <% end %>
        <% if @seasons.empty? %><p class="text-gray-500">등록된 Season이 없습니다.</p><% end %>
      </div>
    </section>
  </main>
</div>
