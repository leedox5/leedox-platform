<% content_for :title, "제품 관리" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-blue-700">Admin Product</p>
        <h1 class="mt-2 text-3xl font-black text-slate-950">제품 관리</h1>
        <p class="mt-2 text-slate-600">
          제품과 그 안의 편을 관리합니다. 새 제품은 여기서만 만듭니다.
          (이전에 만든 콘텐츠 묶음은 <%= link_to "기존 DB 콘텐츠 관리", admin_content_bundles_path, class: "font-bold text-blue-700 hover:underline" %>에 그대로 있습니다.)
        </p>
      </div>
      <%= link_to "+ 새 제품", new_admin_product_line_path, class: "inline-flex flex-shrink-0 items-center justify-center self-start whitespace-nowrap rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 sm:self-auto" %>
    </header>

    <%# Handoff 0097 -- the home's featured section in one place: its title and the featured guides' order. Guides are
        put on the home from their edit page (홈 대표 가이드); here they are ordered or taken off. %>
    <% featured = @product_lines.select(&:featured?).sort_by { |line| [ line.featured_position || ProductLine::FEATURED_MAX + 1, line.id ] } %>
    <section aria-labelledby="home-featured-box" class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 id="home-featured-box" class="text-lg font-black text-slate-950">홈 대표 섹션</h2>
      <p class="mt-1 text-sm text-slate-600">홈 맨 위에 나오는 섹션입니다. 가이드는 최대 <%= ProductLine::FEATURED_MAX %>개, 아래 순서대로 나옵니다(공개 가이드만). 가이드를 넣을 때는 그 가이드의 편집 화면에서 <strong>홈 대표 가이드</strong>를 켭니다.</p>
      <%= form_with url: home_featured_admin_product_lines_path, method: :patch, class: "mt-4 space-y-4" do %>
        <div>
          <%= label_tag :home_title, "섹션 제목", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= text_field_tag :home_title, @home_title, maxlength: SiteSetting::HOME_FEATURED_TITLE_MAX,
            placeholder: SiteSetting::HOME_FEATURED_TITLE_DEFAULT, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm sm:max-w-md" %>
          <p class="mt-1 text-xs text-slate-500">비워 두면 "<%= SiteSetting::HOME_FEATURED_TITLE_DEFAULT %>"로 나옵니다. <%= SiteSetting::HOME_FEATURED_TITLE_MAX %>자까지, 한 줄로(줄바꿈은 빈칸 하나로 바뀝니다).</p>
        </div>
        <div>
          <p class="text-sm font-bold text-slate-700">홈 대표 가이드</p>
          <% if featured.empty? %>
            <p class="mt-1 text-sm text-slate-500">지금 홈 대표 가이드가 없습니다 — 홈에 이 섹션이 나오지 않습니다.</p>
          <% else %>
            <ol class="mt-2 space-y-2">
              <% featured.each do |line| %>
                <li class="flex flex-wrap items-center gap-3" data-home-featured-row>
                  <%= select_tag "positions[#{line.id}]",
                    options_for_select((1..ProductLine::FEATURED_MAX).map { |n| [ "#{n}번째", n ] } + [ [ "홈 대표에서 빼기", "" ] ], line.featured_position),
                    aria: { label: "#{line.customer_name} 순서" }, class: "rounded-lg border border-slate-300 px-2 py-1.5 text-sm" %>
                  <span class="font-semibold text-slate-900"><%= line.customer_name %></span>
                  <% unless ProductLine.listed.exists?(line.id) %>
                    <span class="inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">비공개라 홈에 안 나옴</span>
                  <% end %>
                </li>
              <% end %>
            </ol>
            <p class="mt-2 text-xs text-slate-500">순서는 1~<%= ProductLine::FEATURED_MAX %>을 하나씩 고릅니다(겹치면 저장되지 않습니다).</p>
          <% end %>
        </div>
        <%= submit_tag "저장", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white hover:bg-blue-700" %>
      <% end %>
    </section>

    <section class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-bold uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">대표 이미지</th>
            <th class="px-4 py-3">고객용 제품명</th>
            <th class="px-4 py-3">내부 관리명</th>
            <th class="px-4 py-3">slug</th>
            <th class="whitespace-nowrap px-4 py-3">공개 상태</th>
            <th class="whitespace-nowrap px-4 py-3">편 수</th>
            <th class="whitespace-nowrap px-4 py-3 text-right">조회 누적</th>
            <th class="whitespace-nowrap px-4 py-3 text-right">최근 <%= EpisodeView::RECENT_DAYS %>일</th>
            <th class="whitespace-nowrap px-4 py-3 text-right">관리</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @product_lines.each do |line| %>
            <tr>
              <td class="w-40 px-4 py-4">
                <%= render "admin/product_lines/cover_link", product_line: line, variant: :thumb, caption: true %>
              </td>
              <td class="px-4 py-4 font-semibold text-slate-900">
                <%= line.customer_name %>
                <%# Handoff 0071 -- which series is the home hero, and whether it can actually show there. 0097: with its place. %>
                <% if line.featured? %>
                  <span class="ml-1 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800">대표 <%= line.featured_position %></span>
                  <% unless ProductLine.listed.exists?(line.id) %>
                    <span class="ml-1 inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">비공개라 홈에 안 나옴</span>
                  <% end %>
                <% end %>
                <% if line.track_name %>
                  <span class="mt-1 block text-xs font-normal text-slate-500">홈 줄: <%= line.track_name %></span>
                <% end %>
              </td>
              <td class="px-4 py-4 text-slate-600"><%= line.internal_name %></td>
              <td class="px-4 py-4 text-slate-600"><code><%= line.slug %></code></td>
              <td class="whitespace-nowrap px-4 py-4"><span class="inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-700"><%= line.status %></span></td>
              <td class="whitespace-nowrap px-4 py-4 text-slate-600"><%= line.content_episodes.count %></td>
              <td class="whitespace-nowrap px-4 py-4 text-right tabular-nums text-slate-900" data-view-total><%= view_stats_label(@view_stats[:total][line.id]) %></td>
              <td class="whitespace-nowrap px-4 py-4 text-right tabular-nums text-slate-600" data-view-recent><%= view_stats_label(@view_stats[:recent][line.id]) %></td>
              <td class="whitespace-nowrap px-4 py-4 text-right">
                <%= link_to "편집", edit_admin_product_line_path(line), class: "font-semibold text-blue-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @product_lines.empty? %><p class="p-8 text-center text-slate-500">등록된 제품이 없습니다.</p><% end %>
    </section>
    <div class="mt-3"><%= render "admin/product_lines/view_count_note" %></div>
  </main>
</div>
