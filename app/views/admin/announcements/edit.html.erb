<% content_for :title, "공지 편집" %>
<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-black text-slate-950">공지 편집</h1>
      <div class="flex shrink-0 items-center gap-4 text-sm font-bold">
        <%= link_to "미리보기", preview_admin_announcement_path(@announcement), class: "text-blue-700 hover:underline" %>
        <%= link_to "← 목록으로", admin_announcements_path, class: "text-slate-600 hover:text-slate-900" %>
      </div>
    </header>
    <%= render "admin/announcements/form", announcement: @announcement %>

    <section class="mt-8 rounded-2xl border-2 border-red-200 bg-red-50 p-6">
      <h2 class="text-lg font-bold text-red-900">공지 삭제</h2>
      <p class="mt-1 text-sm text-red-800">삭제하면 되돌릴 수 없습니다. 잠시 내리기만 하려면 위에서 <strong>게시</strong> 체크를 해제하세요.</p>
      <%= button_to "공지 삭제", admin_announcement_path(@announcement), method: :delete,
        data: { turbo_confirm: "\"#{@announcement.title}\" 공지를 삭제할까요? 되돌릴 수 없습니다." },
        class: "mt-4 rounded-lg border-2 border-red-400 bg-red-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-red-700" %>
    </section>
  </main>
</div>
