<% content_for :title, "새 콘텐츠 묶음" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950">새 콘텐츠 묶음</h1>
      <%= link_to "← 목록으로", admin_content_bundles_path, class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= form_with model: @bundle, url: admin_content_bundles_path, class: "mt-8 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @bundle.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @bundle.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <%= f.label :internal_name, "내부 이름", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :internal_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :customer_title, "고객 노출 제목 (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :customer_title, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :product_id, "연결할 Product (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.collection_select :product_id, Product.order(:code), :id, :code, { include_blank: "(연결 안 함)" }, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        <p class="mt-1 text-xs text-slate-500">고객 화면 <code>/content/:product_code</code>에 노출되려면 <code>ProductContent.registry</code>에 DB 소스로 등록된 상품과 연결해야 합니다.</p>
      </div>

      <div>
        <%= f.label :slug, "고객 URL slug", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :slug, placeholder: "예: password-reset-end-to-end", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono" %>
        <p class="mt-1 text-xs text-slate-500">
          소문자·숫자·하이픈만(예: <code>codex-todo</code>). Product에 연결하려면 반드시 필요하며,
          같은 Product 안에서 고유해야 합니다. 예상 고객 URL:
          <code>/content/&lt;product_code&gt;/<%= "<slug>" %></code> — 이 묶음의 편들은 그 안에서
          01부터 시작합니다.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :status, "상태", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.select :status, %w[draft in_review published unpublished archived], {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      </div>

      <%= f.submit "만들기", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </main>
</div>
