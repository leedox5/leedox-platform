<% content_for :title, "#{@bundle.internal_name} 편집" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950"><%= @bundle.internal_name %></h1>
      <%= link_to "← 목록으로", admin_content_bundles_path, class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= form_with model: @bundle, url: admin_content_bundle_path(@bundle), method: :patch, class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
      <% if @bundle.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @bundle.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div>
        <%= f.label :internal_name, "내부 이름", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :internal_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :customer_title, "고객 노출 제목 (선택)", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.text_field :customer_title, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= f.label :product_id, "연결된 Product", class: "block text-sm font-bold text-slate-700 mb-1" %>
        <%= f.collection_select :product_id, Product.order(:code), :id, :code, { include_blank: "(연결 안 함)" }, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :status, "상태", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.select :status, %w[draft in_review published unpublished archived], {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
          <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
        </div>
      </div>

      <%= f.submit "저장", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
    <% end %>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900">편 목록</h2>
        <%= link_to "+ 새 편", new_admin_content_bundle_content_episode_path(@bundle), class: "rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-bold text-white hover:bg-slate-900" %>
      </div>

      <ul class="mt-4 divide-y divide-slate-100">
        <% @episodes.each do |episode| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900">
                <%= episode.position %>. <%= episode.customer_title.presence || "(제목 없음)" %>
              </p>
              <p class="text-xs text-slate-500">
                상태: <span class="font-bold"><%= episode.status %></span>
                · 최종 수정: <%= l(episode.updated_at, format: :long, locale: :ko) %>
              </p>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2">
              <%= link_to "편집", edit_admin_content_episode_path(episode), class: "rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50" %>
            </div>
          </li>
        <% end %>
        <% if @episodes.empty? %><p class="py-6 text-center text-slate-500">아직 편이 없습니다.</p><% end %>
      </ul>
    </section>
  </main>
</div>
