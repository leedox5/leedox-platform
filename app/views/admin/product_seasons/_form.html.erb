<%= form_with model: season, url: url, method: method, class: "mt-6 space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" do |f| %>
  <% if season.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
      <%= season.errors.full_messages.join(", ") %>
    </div>
  <% end %>

  <div>
    <%= f.label :season_code, "Season 코드", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_field :season_code, placeholder: "예: S01", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono" %>
    <p class="mt-1 text-xs text-slate-500">같은 제품 안에서 고유해야 합니다(예: S01, S02). 영문 대문자·숫자만.</p>
  </div>

  <div>
    <%= f.label :internal_name, "내부 관리명", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_field :internal_name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :customer_title, "고객 노출 제목", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_field :customer_title, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    <p class="mt-1 text-xs text-slate-500">비워두면 내부 관리명이 고객 화면에 대신 표시됩니다.</p>
  </div>

  <div>
    <%= f.label :slug, "고객 URL slug", class: "block text-sm font-bold text-slate-700 mb-1" %>
    <%= f.text_field :slug, placeholder: "예: s01", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono" %>
    <p class="mt-1 text-xs text-slate-500">
      고객 URL: <code><%= product_season_path(season.product_line.slug, season.slug.presence || "slug") %></code>
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
    <div>
      <%= f.label :status, "공개 상태", class: "block text-sm font-bold text-slate-700 mb-1" %>
      <%= f.select :status, ProductSeason::STATUSES, {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :visibility, "노출", class: "block text-sm font-bold text-slate-700 mb-1" %>
      <%= f.select :visibility, ProductSeason::VISIBILITIES, {}, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :position, "정렬 순서", class: "block text-sm font-bold text-slate-700 mb-1" %>
      <%= f.number_field :position, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>
  <p class="text-xs text-slate-500">
    published가 아니면 고객에게 보이지 않습니다. 노출: public은 제품 페이지에 나열, unlisted는 나열 없이 URL로만 접근, private은 고객에게 열리지 않습니다.
  </p>

  <%= f.submit submit_label, class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-bold text-white shadow-sm hover:bg-blue-700 cursor-pointer" %>
<% end %>
