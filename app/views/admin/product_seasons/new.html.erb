<% content_for :title, "새 Season — #{@product_line.customer_name}" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="flex items-center justify-between">
      <h1 class="text-2xl font-black text-slate-950">새 Season — <%= @product_line.customer_name %></h1>
      <%= link_to "← 제품으로", edit_admin_product_line_path(@product_line), class: "text-sm font-bold text-slate-600 hover:text-slate-900" %>
    </header>

    <%= render "form", season: @season, url: admin_product_line_product_seasons_path(@product_line), method: :post, submit_label: "만들기" %>
  </main>
</div>
