<% content_for :title, "CHATDOX | AI와 실제 SaaS를 만들고 운영하는 기록" %>
<% content_for :head do %>
  <meta name="description" content="Tommy와 AI가 실제 SaaS를 만들고, 운영하고, 성장시키며 남긴 결과와 과정의 기록. S01 구축과 출시, S02 운영과 사업 활용을 함께 다룹니다.">
<% end %>

<div class="min-h-screen">
  <%= render "shared/header" %>

  <main>
    <%= render "landing/hero", hub: @chatdox_hub %>
    <%= render "landing/season_hub", hub: @chatdox_hub %>
    <%= render "landing/product" %>
    <%= render "shared/product_pricing", product_code: "chatdox" %>
    <%= render "landing/faq" %>
    <%= render "landing/cta" %>
  </main>

  <%= render "shared/footer" %>
