<% content_for :title, "가격 | LEEDOX" %>

<div class="min-h-screen bg-slate-50">
  <%= render "shared/header" %>

  <main class="mx-auto w-full max-w-6xl px-2 py-6 sm:px-6">
    <div class="mb-4">
      <p class="text-sm font-black uppercase tracking-[0.18em] text-indigo-700">Pricing</p>
      <h1 class="mt-2 break-keep text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">상품별 가격</h1>
      <p class="mt-3 max-w-2xl break-keep text-slate-600">LEEDOX가 제공하는 상품들을 한눈에 확인하세요. 자세한 구성과 전체 가격표는 각 상품 페이지에서 볼 수 있습니다.</p>
    </div>

    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      <% @products.each do |product| %>
        <%# Badge and price come from StandaloneProductsHelper (shared with the home since handoff 0071). %>
        <% state = standalone_product_state(product) %>
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-xl font-black tracking-tight text-slate-950"><%= product.name %></h2>
            <span class="rounded-full px-3 py-1 text-xs font-bold <%= state == :preparing ? "bg-amber-50 text-amber-700" : "bg-emerald-50 text-emerald-700" %>"><%= standalone_product_badge(product) %></span>
          </div>

          <p class="mt-3 flex-1 break-keep text-sm leading-6 text-slate-600"><%= product.tagline %></p>

          <p class="mt-5 text-2xl font-black text-slate-950">
            <%= standalone_product_price(product) %>
          </p>

          <% if product.landing_page_path.present? %>
            <% detail_target = product.landing_page_path %>
            <% preparing = state == :preparing %>
            <% cta_classes = preparing ?
              "mt-6 inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-600 transition hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" :
              "mt-6 inline-flex items-center justify-center rounded-xl bg-blue-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" %>
            <%= link_to (product.free_access? ? "무료로 시작하기" : "자세히 보기"), detail_target, class: cta_classes %>
          <% end %>
        </article>
      <% end %>
    </div>
  </main>

  <%= render "shared/footer" %>
</div>
