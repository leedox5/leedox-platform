<%# Handoff 0071 (f) -- what the units mean here, fixed copy from the request. Handoff 0091 (D-011) -- 가이드 ·
    에피소드 · 실전 (시즌 is gone); same three blocks, same shape.
    Handoff 0098 -- moved from the home (leedox_home/_series_explainer) to the about page, blocks and copy unchanged;
    the page's own spacing replaces the home's top rule. %>
<% blocks = [
  [ "가이드", "하나의 주제, 하나의 완결", "Git, Java, WSL, AI 협업처럼 주제마다 가이드 하나. 그 자체로 끝까지 갑니다." ],
  [ "에피소드", "한 편에 한 장면", "각 편은 질문 하나에 답하고, 다음 편의 질문을 남기며 끝납니다." ],
  [ "실전", "부딪힌 자리까지", "잘 된 결과만이 아니라, 막히고 고친 과정을 그대로 엮었습니다." ]
] %>
<section aria-labelledby="series-explainer">
  <div class="mx-auto max-w-6xl px-2.5 py-10 sm:px-7 md:py-14">
    <h2 id="series-explainer" class="sr-only">가이드 · 에피소드 · 실전</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <% blocks.each do |label, title, body| %>
        <div>
          <p class="font-mono text-xs font-semibold tracking-wide text-[#f0a53c]"><%= label %></p>
          <h3 class="mt-2 break-keep font-display text-xl font-bold text-[#f2efe8]"><%= title %></h3>
          <p class="mt-2 break-keep text-sm leading-relaxed text-[#a8a39a]"><%= body %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
