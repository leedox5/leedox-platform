<%# Handoff 0071 -- the story-series home (D-009). Dark on the home only; every other page keeps its theme.
    Sections, top to bottom: the pinned notice line (0077, only when one is published and pinned), featured guides
    (0097: up to three, only when featured and listed), one row per track (the AI row also carries the standalone
    products), the line to /about, footer.
    Handoff 0098 -- content only: the brand line and the 가이드 · 에피소드 · 실전 blocks moved to /about. The page's one
    h1 is the brand sentence, for screen readers only (sr-only) -- the visible headings are the sections' h2s. %>
<%# Handoff 0091 (D-011) -- the brand sentence; 시리즈 is called 가이드 now and 시즌 is gone from the screens. %>
<% content_for :title, "LEEDOX | 실제로 만들고 부딪히며 엮은 개발자의 실전 가이드" %>
<% content_for :color_scheme, "dark" %><%# Handoff 0100 -- a dark page (FrameThemeHelper#body_class) %>
<% content_for :head do %>
  <meta name="description" content="실제로 만들고 부딪히며 엮은 개발자의 실전 가이드. 매끈한 강의 대신, 막히고 고친 과정까지 한 편씩 따라갑니다. Git·Java·WSL 같은 개발 기초부터 AI와 함께 만드는 이야기까지.">
  <%# The display serif (see --font-display in application.css) -- shared with the series list since 0083. %>
  <%= render "shared/display_font" %>
<% end %>

<div class="min-h-screen bg-[#0e1014] text-[#f2efe8]">
  <%= render "shared/header", dark: true %>
  <%= render "leedox_home/notice_line", notice_item: @home_notice if @home_notice %>

  <main>
    <h1 id="brand-line" class="sr-only">실제로 만들고 부딪히며 엮은 개발자의 실전 가이드</h1>
    <%= render "leedox_home/series_hero" if @featured_lines.any? %>
    <%# Handoff 0096 -- no "새로 공개 · 공개 예정" row any more (Tommy: dull on a phone). %>
    <%= render "leedox_home/track_rows" %>
    <p class="mx-auto max-w-6xl px-2.5 py-6 text-center text-sm sm:px-7" data-about-line>
      <a href="<%= about_path %>" class="text-[#a8a39a] transition hover:text-[#f2efe8]">LEEDOX는 어떤 곳인가요? <span aria-hidden="true" class="text-[#f0a53c]">→</span></a>
    </p>
  </main>

  <%= render "shared/footer" %>
</div>
