<%# Handoff 0098 -- what LEEDOX is: the brand sentence (the page's h1), the line under it and the 가이드 · 에피소드 ·
    실전 blocks, all moved from the home with their copy unchanged, then a way to the guides. Dark like the home and
    the guide list (D-010). A place for how-to / roadmap later; only these four now. %>
<% content_for :title, "LEEDOX 소개 | LEEDOX" %>
<% content_for :head do %>
  <meta name="description" content="실제로 만들고 부딪히며 엮은 개발자의 실전 가이드. 매끈한 강의 대신, 막히고 고친 과정까지 한 편씩 따라갑니다. Git·Java·WSL 같은 개발 기초부터 AI와 함께 만드는 이야기까지.">
  <%= render "shared/display_font" %>
<% end %>

<div class="min-h-screen bg-[#0e1014] text-[#f2efe8]">
  <%= render "shared/header", dark: true %>

  <main>
    <section aria-labelledby="about-brand" class="mx-auto max-w-6xl px-2.5 pt-12 sm:px-7 md:pt-20">
      <h1 id="about-brand" class="max-w-3xl break-keep font-display text-[28px] font-bold leading-9 text-[#f2efe8] md:text-[40px] md:leading-[52px]">실제로 만들고 부딪히며 엮은 개발자의 실전 가이드.</h1>
      <p class="mt-4 max-w-3xl break-keep leading-relaxed text-[#a8a39a] md:mt-6 md:text-lg">매끈한 강의 대신, 막히고 고친 과정까지 한 편씩 따라갑니다. Git·Java·WSL 같은 개발 기초부터 AI와 함께 만드는 이야기까지.</p>
    </section>

    <%= render "pages/about_units" %>

    <div class="mx-auto max-w-6xl px-2.5 pb-16 sm:px-7 md:pb-24">
      <a href="<%= products_path %>" class="inline-flex items-center justify-center whitespace-nowrap rounded-xl bg-[#f0a53c] px-6 py-3 text-sm font-bold text-[#0e1014] hover:bg-[#f5b85e]">가이드 보러 가기</a>
    </div>
  </main>

  <%= render "shared/footer" %>
</div>
