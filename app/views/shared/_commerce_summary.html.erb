<section aria-label="상품별 라이선스" class="mt-6 rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <%# Handoff 0081 R2 -- no "{상품} 구매" links here any more (Tommy, 2026-10-04): buying and extending start from
      /pricing and each product page, whose price blocks lead to the same checkout. %>
  <h2 class="text-lg font-bold text-gray-900">상품별 라이선스</h2>

  <%# Handoff 0081 -- one card per product (a series' commerce product shows as that series, under its current
      name), built by MypageController#license_cards: 이용 중 -> 이용 예정 -> 무료 이용 -> 만료. Other license records
      of the same product fold into "지난 기록 N건". The purchase links above and the orders below are unchanged. %>
  <% status_labels = { "active" => "이용 중", "scheduled" => "이용 예정", "expired" => "만료", "canceled" => "취소" } %>
  <% if license_cards.any? %>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <% license_cards.each do |card| %>
        <% free = card.status == "free" %>
        <article class="rounded-xl border p-5 <%= free ? "border-emerald-200 bg-emerald-50" : "border-slate-200 bg-slate-50" %>" data-license-card="<%= card.product.code %>">
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-bold text-slate-900"><%= card.title %></h3>
            <span class="rounded-full bg-white px-3 py-1 text-xs font-bold <%= free ? "text-emerald-700" : "text-slate-700" %>"><%= free ? "무료 이용" : status_labels.fetch(card.status) %></span>
          </div>
          <% period = if free then "전체 이용 가능 · 기간 제한 없음"
             elsif card.status == "active" then dashboard_license_period_text(card.license)
             elsif card.status == "scheduled" then license_scheduled_period_text(card.license)
             else license_expired_period_text(card.license)
             end %>
          <p class="mt-3 text-sm text-slate-600"><%= period %></p>
          <% if card.link %>
            <%= link_to "콘텐츠 보기", card.link, class: "mt-3 inline-block text-sm font-semibold #{free ? "text-emerald-700" : "text-blue-700"} hover:underline" %>
          <% end %>
          <% if card.past.any? %>
            <details class="mt-3 text-sm">
              <summary class="cursor-pointer select-none font-semibold text-slate-500 hover:text-slate-700">지난 기록 <%= card.past.size %>건</summary>
              <ul class="mt-2 space-y-1 text-xs text-slate-500">
                <% card.past.each do |license| %>
                  <li><%= license_span_text(license) %> · <%= status_labels.fetch(license.effective_status) %></li>
                <% end %>
              </ul>
            </details>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>
  <% unless license_cards.any? { |card| card.status != "free" } %>
    <p class="mt-4 rounded-lg bg-slate-50 p-5 text-sm text-slate-600">아직 유료 상품 라이선스가 없습니다.</p>
  <% end %>

  <% if orders.any? %>
    <div class="mt-7 border-t border-slate-100 pt-5">
      <h3 class="font-bold text-slate-900">최근 주문</h3>
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        <% orders.each do |order| %>
          <li class="py-3">
            <% order_refund_requests = order.refund_requests.to_a %>
            <% open_refund = order_refund_requests.find(&:open?) %>
            <% completed_refund = order_refund_requests.find { |request| request.status == "refunded" } %>
            <% # Reuses the same License#effective_status every other screen (dashboard,
               # license cards above) already reads, rather than a display-only expiry
               # check of its own -- this project has been burned before by display and
               # actual access logic drifting apart. %>
            <% order_licenses = order.licenses.to_a %>
            <% all_licenses_expired = order_licenses.any? && order_licenses.all? { |license| license.effective_status == "expired" } %>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="min-w-0">
                <span class="text-slate-700"><%= order.order_items.first&.product_name || "상품" %> · <%= number_with_delimiter(order.total_amount) %>원</span>
                <p class="mt-0.5 break-keep text-xs text-slate-500">
                  <%= I18n.l(order.created_at.to_date, locale: :ko, format: :long) %> · 주문번호 <%= manual_transfer_reference(order) %> · <%= provider_label(order.provider) %>
                  <% if order_licenses.any? %>
                    · 이용 기간 <%= I18n.l(order_licenses.map(&:starts_on).min, locale: :ko, format: :long) %> ~ <%= order_licenses.any?(&:indefinite?) ? "무기한" : I18n.l(order_licenses.map(&:last_usable_on).max, locale: :ko, format: :long) %>
                  <% end %>
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <% # Order itself has no "refunded" status (see app/models/order.rb) -- it stays
                   # "paid" forever, so a completed refund has to override the label here rather
                   # than being read off order.status directly. %>
                <span class="font-semibold text-slate-600"><%= completed_refund ? "환불 완료" : { "pending" => "결제 대기", "paid" => "결제 완료", "failed" => "결제 실패", "canceled" => "취소", "abandoned" => "결제 이탈" }.fetch(order.status) %></span>
                <% if open_refund %>
                  <%= link_to "환불 요청 확인", refund_request_path(open_refund.public_id), class: "font-semibold text-indigo-700 hover:underline" %>
                <% elsif completed_refund %>
                  <%= link_to "환불 내역 보기", refund_request_path(completed_refund.public_id), class: "font-semibold text-indigo-700 hover:underline" %>
                <% elsif order.status == "paid" && !all_licenses_expired %>
                  <%= link_to "환불 요청", new_billing_order_refund_request_path(order.public_id), class: "font-semibold text-indigo-700 hover:underline" %>
                <% elsif (order.status == "abandoned" || (order.status == "pending" && Commerce::PendingOrderAssessment.call(order: order).safe_to_abandon)) && Commerce::Sales.enabled_for_code?(order.order_items.first&.product_code) %>
                  <%= link_to "새 주문으로 재시도", retry_billing_order_path(order.public_id), class: "font-semibold text-blue-700 hover:underline" %>
                <% end %>
              </div>
            </div>
            <% if order.status == "pending" %>
              <p class="mt-1 text-xs text-slate-500">결제가 완료되지 않은 주문입니다.</p>
            <% elsif order.status == "paid" && all_licenses_expired && !open_refund && !completed_refund %>
              <p class="mt-1 text-xs text-slate-500">이용이 끝난 건은 환불이 제한됩니다. 문의는 leedox@naver.com으로 보내주세요.</p>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if orders_page.present? && (orders_page > 1 || has_more_orders) %>
        <div class="mt-4 flex items-center justify-between gap-3 text-sm">
          <% if orders_page > 1 %>
            <%= link_to "← 이전", mypage_path(orders_page: orders_page - 1), class: "font-semibold text-blue-600 hover:text-blue-700" %>
          <% else %>
            <span></span>
          <% end %>
          <% if has_more_orders %>
            <%= link_to "다음 →", mypage_path(orders_page: orders_page + 1), class: "font-semibold text-blue-600 hover:text-blue-700" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
