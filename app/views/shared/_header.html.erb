<%# Handoff 0071 -- `dark: true` gives the same header in the home's dark palette; every other page renders it exactly
    as before. The Chatdox / Claudox / Antigravity shortcuts moved to the home's "AI와 함께 만들기" row.
    Handoff 0083 -- the dark "browse" pages (home, series list) pass `dark: true`, and the mobile menu panel follows
    it there; on light pages the panel is unchanged. %>
<% dark = local_assigns.fetch(:dark, false) %>
<header class="sticky top-0 z-50 border-b backdrop-blur <%= dark ? "border-white/10 bg-[#0e1014]/90" : "border-slate-200/70 bg-white/90 shadow-sm" %>">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <div class="flex items-center gap-4">
      <%= link_to root_path, class: "group inline-flex items-center gap-2 text-lg font-black tracking-tight #{dark ? "text-[#f2efe8]" : "text-slate-950"} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" do %>
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-sm font-black transition <%= dark ? "bg-[#f0a53c] text-[#0e1014]" : "bg-slate-950 text-white group-hover:bg-indigo-700" %>">L</span>
        LEEDOX
      <% end %>
    </div>

    <nav aria-label="주요 내비게이션" class="hidden items-center gap-4 text-sm font-medium md:flex <%= dark ? "text-[#c9c4ba]" : "text-slate-600" %>">

      <% primary_navigation_items.each do |label, path| %>
        <%= link_to label, path, class: "rounded transition #{dark ? "hover:text-[#f2efe8]" : "hover:text-slate-950"} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" %>
      <% end %>

      <% if user_signed_in? %>
        <span class="max-w-48 truncate <%= dark ? "text-[#a8a39a]" : "text-slate-500" %>"><%= current_user.name %></span>
        <%= link_to "로그아웃",
          destroy_user_session_path,
          data: { turbo_method: :delete },
          class: dark ? "rounded-lg border border-white/25 px-4 py-2 text-[#f2efe8] transition hover:border-white/50" : "rounded-lg border border-red-200 px-4 py-2 text-red-600 transition hover:border-red-300 hover:bg-red-50" %>
      <% else %>
        <%= link_to "로그인",
          new_user_session_path,
          class: dark ? "rounded-lg border border-white/25 px-4 py-2 text-[#f2efe8] transition hover:border-white/50" : "rounded-lg border border-slate-200 px-4 py-2 text-slate-700 transition hover:border-slate-300 hover:text-slate-900" %>
        <%= link_to "회원가입",
          new_user_registration_path,
          class: dark ? "rounded-lg bg-[#f0a53c] px-4 py-2 font-semibold text-[#0e1014] transition hover:bg-[#f5b85e]" : "rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white transition hover:bg-blue-700" %>
      <% end %>
    </nav>

    <details class="group relative md:hidden" data-controller="mobile-menu">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border transition <%= dark ? "border-white/25 text-[#f2efe8] hover:bg-white/10" : "border-slate-200 text-slate-700 hover:bg-slate-50" %> focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" aria-label="메뉴 열기">
        <span aria-hidden="true" class="text-xl leading-none">☰</span>
      </summary>
      <div class="absolute right-0 mt-3 w-64 overflow-hidden rounded-xl border p-2 shadow-xl <%= dark ? "border-white/10 bg-[#15181e]" : "border-slate-200 bg-white" %>">
        <nav aria-label="모바일 내비게이션">
          <% primary_navigation_items.each do |label, path| %>
            <%= link_to label, path, class: "block rounded-lg px-3 py-2.5 text-sm font-medium transition #{dark ? "text-[#c9c4ba] hover:bg-white/5 hover:text-[#f2efe8]" : "text-slate-700 hover:bg-slate-50 hover:text-slate-950"} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
          <% end %>

          <div class="my-2 border-t <%= dark ? "border-white/10" : "border-slate-100" %>"></div>
          <% if user_signed_in? %>
            <p class="truncate px-3 pb-2 text-xs <%= dark ? "text-[#a8a39a]" : "text-slate-500" %>"><%= current_user.name %></p>
            <%= link_to "로그아웃",
              destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "block rounded-lg px-3 py-2.5 text-sm font-semibold transition #{dark ? "text-[#f0a53c] hover:bg-white/5" : "text-red-600 hover:bg-red-50"} focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500" %>
          <% else %>
            <div class="grid grid-cols-2 gap-2">
              <%= link_to "로그인", new_user_session_path, class: "rounded-lg border px-3 py-2 text-center text-sm font-semibold transition #{dark ? "border-white/25 text-[#f2efe8] hover:border-white/50" : "border-slate-200 text-slate-700 hover:bg-slate-50"} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
              <%= link_to "회원가입", new_user_registration_path, class: "rounded-lg px-3 py-2 text-center text-sm font-semibold transition #{dark ? "bg-[#f0a53c] text-[#0e1014] hover:bg-[#f5b85e]" : "bg-blue-600 text-white hover:bg-blue-700"} focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" %>
            </div>
          <% end %>
        </nav>
      </div>
    </details>
  </div>
</header>
