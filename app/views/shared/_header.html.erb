<%# Handoff 0071 -- `dark: true` gives the same header in the home's dark palette; every other page renders it exactly
    as before. The Chatdox / Claudox / Antigravity shortcuts moved to the home's "AI와 함께 만들기" row.
    Handoff 0083 -- the dark "browse" pages (home, series list) pass `dark: true`, and the mobile menu panel follows
    it there; on light pages the panel is unchanged.
    Handoff 0084 (D-010) -- the frame is dark on every customer page: dark is now the default (FrameThemeHelper#
    dark_frame?), and only screens admins use (Admin::, service desk, refs) keep the light header. `dark:` can still be
    passed explicitly. Every conditional color class comes from FrameThemeHelper (a .rb file) -- in an ERB Ruby string
    Tailwind silently skipped them, which left the dark header's own background unbuilt (transparent) since 0071. %>
<% dark = local_assigns.fetch(:dark) { dark_frame? } %>
<header class="sticky top-0 z-50 border-b backdrop-blur <%= frame_theme(:header, dark) %>">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <div class="flex items-center gap-4">
      <%= link_to root_path, class: "group inline-flex items-center gap-2 text-lg font-black tracking-tight #{frame_theme(:logo, dark)} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" do %>
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-sm font-black transition <%= frame_theme(:logo_mark, dark) %>">L</span>
        LEEDOX
      <% end %>
    </div>

    <nav aria-label="주요 내비게이션" class="hidden items-center gap-4 text-sm font-medium md:flex <%= frame_theme(:nav, dark) %>">

      <% primary_navigation_items.each do |label, path| %>
        <%= link_to label, path, class: "rounded transition #{frame_theme(:nav_link, dark)} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" %>
      <% end %>

      <%# Handoff 0103 -- the dark / light switch, before 로그인 / 회원가입 or the name and 로그아웃; customer pages only. %>
      <% if dark %><%= render "shared/theme_toggle", classes: "h-9 w-9" %><% end %>

      <% if user_signed_in? %>
        <span class="max-w-48 truncate <%= frame_theme(:user_name, dark) %>"><%= current_user.name %></span>
        <%= link_to "로그아웃",
          destroy_user_session_path,
          data: { turbo_method: :delete },
          class: frame_theme(:logout, dark) %>
      <% else %>
        <%= link_to "로그인",
          new_user_session_path,
          class: frame_theme(:login, dark) %>
        <%= link_to "회원가입",
          new_user_registration_path,
          class: frame_theme(:signup, dark) %>
      <% end %>
    </nav>

    <%# Handoff 0103 -- on phones the switch sits left of ☰ (ml-auto keeps it beside the menu button), one tap away. %>
    <% if dark %><%= render "shared/theme_toggle", classes: "ml-auto mr-2 h-10 w-10 border border-line/25 hover:bg-tint/10 md:hidden" %><% end %>

    <details class="group relative md:hidden" data-controller="mobile-menu">
      <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border transition <%= frame_theme(:menu_button, dark) %> focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2" aria-label="메뉴 열기">
        <span aria-hidden="true" class="text-xl leading-none">☰</span>
      </summary>
      <div class="absolute right-0 mt-3 w-64 overflow-hidden rounded-xl border p-2 shadow-xl <%= frame_theme(:panel, dark) %>">
        <nav aria-label="모바일 내비게이션">
          <% primary_navigation_items.each do |label, path| %>
            <%= link_to label, path, class: "block rounded-lg px-3 py-2.5 text-sm font-medium transition #{frame_theme(:panel_link, dark)} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
          <% end %>

          <div class="my-2 border-t <%= frame_theme(:panel_divider, dark) %>"></div>
          <% if user_signed_in? %>
            <p class="truncate px-3 pb-2 text-xs <%= frame_theme(:panel_name, dark) %>"><%= current_user.name %></p>
            <%= link_to "로그아웃",
              destroy_user_session_path,
              data: { turbo_method: :delete },
              class: "block rounded-lg px-3 py-2.5 text-sm font-semibold transition #{frame_theme(:panel_logout, dark)} focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500" %>
          <% else %>
            <div class="grid grid-cols-2 gap-2">
              <%= link_to "로그인", new_user_session_path, class: "rounded-lg border px-3 py-2 text-center text-sm font-semibold transition #{frame_theme(:panel_login, dark)} focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
              <%= link_to "회원가입", new_user_registration_path, class: "rounded-lg px-3 py-2 text-center text-sm font-semibold transition #{frame_theme(:panel_signup, dark)} focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2" %>
            </div>
          <% end %>
        </nav>
      </div>
    </details>
  </div>
</header>
