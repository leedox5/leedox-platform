<%# Handoff 0084 (D-010) -- the frame is dark on every customer page (the footer isn't used in /admin). Content and
    links are unchanged; the top border marks the edge on light-bodied pages (my page, notices, checkout...). %>
<footer class="border-t border-line/10 bg-page py-10">
  <div class="mx-auto w-full max-w-6xl px-4 text-sm text-ink-3 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <div class="space-y-2">
        <p class="mb-4 text-base font-black tracking-tight text-ink">LEEDOX</p>
        <p><%= CompanyInfo::NAME %> | 대표 <%= CompanyInfo::REPRESENTATIVE %></p>
        <p>사업자등록번호 <%= CompanyInfo::REGISTRATION_NUMBER %></p>
        <p>통신판매업신고 <%= CompanyInfo::MAIL_ORDER_LICENSE %></p>
        <p>주소 <%= CompanyInfo::ADDRESS %></p>
        <p>이메일 <%= CompanyInfo::EMAIL %></p>
        <p>유선 <%= CompanyInfo::PHONE %></p>
      </div>

      <div class="space-y-2 md:text-right">
        <%# Handoff 0072 -- the Chatdox / Claudox / Antigravity links left with the header's shortcuts (0071); those
            products are introduced on the home's AI row and /pricing. Only the legal links stay here. %>
        <div class="flex flex-wrap gap-4 md:justify-end">
          <%# Handoff 0077 -- notices sit before the legal links. Handoff 0098 -- LEEDOX 소개 first. %>
          <%= link_to "LEEDOX 소개", about_path, class: FrameThemeHelper::FOOTER_LINK_CLASS %>
          <%= link_to "공지", announcements_path, class: FrameThemeHelper::FOOTER_LINK_CLASS %>
          <%= link_to "이용 약관", terms_path, class: FrameThemeHelper::FOOTER_LINK_CLASS %>
          <%= link_to "개인정보 처리 방침", privacy_path, class: FrameThemeHelper::FOOTER_LINK_CLASS %>
          <%= link_to "사업자정보확인",
            "https://www.ftc.go.kr/bizCommPop.do?wrkr_no=#{CompanyInfo::REGISTRATION_NUMBER.delete('-')}",
            target: "_blank", rel: "noopener", class: FrameThemeHelper::FOOTER_LINK_CLASS %>
        </div>
        <p>© 2026 LEEDOX. All rights reserved.</p>
      </div>
    </div>
  </div>
</footer>
