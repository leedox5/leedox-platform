<% content_for :title, "#{@season[:title]} | CHATDOX" %>
<% content_for :head do %>
  <link rel="canonical" href="<%= chatdox_season_url(@season[:code], host: ENV.fetch('CANONICAL_HOST', 'leedox.up.railway.app'), protocol: 'https', port: nil) %>">
<% end %>

<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto w-full max-w-5xl px-5 py-10 sm:px-8 sm:py-14">
    <nav aria-label="breadcrumb" class="text-sm text-slate-600">
      <%= link_to "CHATDOX", chatdox_path, class: "hover:text-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" %>
      <span aria-hidden="true" class="px-2">/</span>
      <span><%= @season[:title] %></span>
    </nav>

    <header class="mt-8 border-b border-slate-200 pb-8">
      <p class="text-sm font-bold uppercase text-blue-700">CHATDOX <%= @season[:code].upcase %></p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold text-slate-950 sm:text-4xl"><%= @season[:title] %></h1>
        <% if @season[:status] == :upcoming %>
          <span class="border border-slate-300 bg-slate-50 px-2 py-1 text-xs font-semibold text-slate-700">준비 중</span>
        <% end %>
      </div>
      <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">
        <% if @season[:code] == "s02" %>
          Work를 SaaS의 HQ로 삼아 운영, 고객, 마케팅, 홍보와 분석으로 확장해 가는 다음 시즌을 준비하고 있습니다.
        <% else %>
          AI와 함께 실제 SaaS를 설계하고 출시하는 과정을 순서대로 다룹니다.
        <% end %>
      </p>
    </header>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <%= render "progress", label: "전체 진도", segment: @summary.overall %>
      <%= render "progress", label: @season[:title], segment: @season_summary %>
    </div>

    <% if @chapters.empty? %>
      <section class="py-14 text-center" aria-label="공개 episode">
        <h2 class="text-xl font-bold text-slate-900">준비 중입니다</h2>
        <p class="mt-2 text-sm text-slate-600">공개된 episode가 아직 없습니다.</p>
      </section>
    <% else %>
      <section class="py-10" aria-label="공개 episode">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-xl font-bold text-slate-950">공개 Episode</h2>
          <span class="text-sm text-slate-500"><%= @chapters.size %>편</span>
        </div>
        <ol class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
          <% @chapters.each do |chapter| %>
            <li>
              <%= link_to chatdox_episode_path(chapter[:season_code], chapter[:display_number]), class: "group flex min-h-20 items-center gap-4 py-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500" do %>
                <span class="w-12 shrink-0 text-sm font-bold text-blue-700"><%= chapter[:display_number] %></span>
                <span class="min-w-0 flex-1 font-semibold text-slate-900 group-hover:text-blue-700"><%= chapter[:title] %></span>
                <span aria-hidden="true" class="text-slate-400">→</span>
              <% end %>
            </li>
          <% end %>
        </ol>
      </section>
    <% end %>
  </main>
  <%= render "shared/footer" %>
</div>
