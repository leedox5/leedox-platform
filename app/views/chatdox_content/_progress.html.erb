<section aria-label="<%= label %>" class="border-y border-slate-200 py-5">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-sm font-semibold text-slate-700"><%= label %></h2>
      <% if segment&.available? %>
        <p class="mt-1 text-lg font-bold text-slate-950">완료 <%= segment.completed_count %> / 공개 <%= segment.available_count %></p>
      <% else %>
        <p class="mt-1 text-sm text-slate-600">공개된 episode가 아직 없습니다.</p>
      <% end %>
    </div>
    <% if segment&.available? %>
      <strong class="text-2xl text-blue-700"><%= segment.percentage %>%</strong>
    <% end %>
  </div>
  <% if segment&.available? %>
    <div class="mt-3 h-2 overflow-hidden bg-slate-200" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= segment.percentage %>">
      <div class="h-full bg-blue-600" style="width: <%= segment.percentage %>%"></div>
    </div>
  <% end %>
</section>
