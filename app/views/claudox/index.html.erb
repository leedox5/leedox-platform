<div class="min-h-screen bg-gray-50">
  <%= render "shared/header" %>

  <div class="mx-auto max-w-4xl px-4 py-16">
    <div class="mb-12">
      <%= link_to "← LEEDOX", root_path, class: "mb-3 inline-block text-sm text-gray-500 hover:text-blue-600" %>
      <div class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600">클로독스</div>
      <h1 class="mb-4 text-4xl font-bold text-gray-900">전체 목차</h1>
      <p class="text-lg text-gray-500">
        클로드가 들어온 날부터 팀이 달라지기까지, 실제로 겪은 순서대로 구성되어 있습니다.
      </p>
    </div>

    <div class="space-y-4">
      <% @phase_chapters.each_with_index do |phase, index| %>
        <details class="group overflow-hidden rounded-2xl border border-gray-200 bg-white" <%= "open" if index.zero? %>>
          <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-4 hover:bg-gray-50">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-blue-50 text-sm font-bold text-blue-600">
              <%= phase[:label].split.last %>
            </div>

            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wide text-blue-600"><%= phase[:label] %></p>
              <h2 class="text-lg font-semibold text-gray-900"><%= phase[:title] %></h2>
              <p class="text-sm text-gray-500"><%= phase[:description] %></p>
            </div>

            <div class="text-right">
              <p class="text-xs text-gray-400">진행도</p>
              <p class="text-sm font-semibold text-gray-700"><%= phase[:available_count] %>/<%= phase[:total_count] %></p>
            </div>

            <span class="text-gray-400 transition-transform group-open:rotate-180">⌄</span>
          </summary>

          <div class="space-y-3 border-t border-gray-100 bg-gray-50 px-4 py-4 sm:px-5">
            <% phase[:chapters].each do |chapter| %>
              <%= render "claudox/index_chapter_row", chapter: chapter %>
            <% end %>
          </div>
        </details>
      <% end %>

      <% if @appendix_chapters.any? %>
        <details class="group overflow-hidden rounded-2xl border border-gray-200 bg-white">
          <summary class="flex cursor-pointer list-none items-center gap-4 px-5 py-4 hover:bg-gray-50">
            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-amber-50 text-sm font-bold text-amber-600">
              +
            </div>

            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold uppercase tracking-wide text-amber-600">부록</p>
              <h2 class="text-lg font-semibold text-gray-900">특별판</h2>
              <p class="text-sm text-gray-500">정규 20장 흐름 밖에서, 챕터 하나로 딱 떨어지지 않는 이야기를 담습니다.</p>
            </div>

            <div class="text-right">
              <p class="text-xs text-gray-400">공개</p>
              <p class="text-sm font-semibold text-gray-700"><%= @appendix_chapters.size %>개</p>
            </div>

            <span class="text-gray-400 transition-transform group-open:rotate-180">⌄</span>
          </summary>

          <div class="space-y-3 border-t border-gray-100 bg-gray-50 px-4 py-4 sm:px-5">
            <% @appendix_chapters.each do |chapter| %>
              <%= render "claudox/index_chapter_row", chapter: chapter %>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
  </div>
</div>
