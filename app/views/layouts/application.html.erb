<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "LEEDOX" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="LEEDOX">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Handoff 0100 / 0102 -- see FrameThemeHelper#body_class and #light_theme?. %>
    <% if dark_page? %><meta name="color-scheme" content="<%= dark_page_color_scheme %>"><% end %>
    <%# Handoff 0103 -- the phone browser bar follows the mode (the page token); customer pages only. %>
    <% if dark_frame? %><meta name="theme-color" content="<%= theme_color %>"><% end %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= body_class %>"<% if light_theme? %> data-theme="light"<% end %>>
    <% if notice.present? || alert.present? %>
      <div
        class="fixed right-4 top-[68px] z-[100] w-[calc(100%-2rem)] max-w-sm space-y-2 sm:right-6 md:top-[64px]"
        data-controller="flash"
      >
        <% if notice.present? %>
          <div class="rounded-lg border border-blue-100 bg-blue-50 px-4 py-3 text-sm font-medium text-blue-700 shadow-sm">
            <%= notice %>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="rounded-lg border border-red-100 bg-red-50 px-4 py-3 text-sm font-medium text-red-700 shadow-sm">
            <%= alert %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
