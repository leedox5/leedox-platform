<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-5 py-10 sm:px-7">
    <%= link_to "← #{@display_name}", product_content_index_path(@product_code), class: "mb-3 inline-block text-sm text-gray-500 hover:text-blue-600" %>

    <h1 class="text-2xl font-bold text-gray-900"><%= @bundle.customer_title.presence || @bundle.internal_name %></h1>

    <ol class="mt-8 space-y-3">
      <% @episodes.each do |episode| %>
        <li>
          <%= link_to product_bundle_episode_path(@product_code, @bundle.slug, episode.display_id),
            class: "block rounded-xl border border-gray-200 p-4 transition hover:border-blue-300 hover:bg-blue-50/40" do %>
            <span class="text-xs font-semibold uppercase tracking-wide text-blue-600">Chapter <%= episode.display_id %></span>
            <p class="mt-1 font-semibold text-gray-900"><%= episode.customer_title.presence || "(제목 없음)" %></p>
          <% end %>
        </li>
      <% end %>
      <% if @episodes.empty? %>
        <p class="text-gray-500">아직 공개된 편이 없습니다.</p>
      <% end %>
    </ol>
  </main>
</div>
