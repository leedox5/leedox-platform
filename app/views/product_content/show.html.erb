<% theme_classes = content_theme_classes(@theme[:accent]) %>
<div class="min-h-screen bg-white">
  <%= render "shared/header" %>

  <div class="flex">
    <aside class="sticky top-14 hidden h-[calc(100vh-56px)] w-72 flex-shrink-0 overflow-y-auto border-r border-gray-200 bg-gray-50 md:block">
      <div class="p-6">
        <div class="mb-6">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400"><%= @theme[:label] || @display_name %></h2>
        </div>

        <nav class="space-y-2">
          <% @phase_chapters.each do |phase| %>
            <% current_in_phase = phase[:chapters].any? { |chapter| chapter[:id] == @current_id } %>

            <details class="group overflow-hidden rounded-xl border border-gray-200 bg-white" <%= "open" if current_in_phase %>>
              <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 hover:bg-gray-50">
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] font-semibold uppercase tracking-wide <%= theme_classes[:label] %>"><%= phase[:label] %></p>
                  <p class="truncate text-sm font-medium text-gray-800"><%= phase[:title] %></p>
                </div>

                <span class="text-xs font-semibold text-gray-500"><%= phase[:available_count] %>/<%= phase[:total_count] %></span>
                <span class="text-xs text-gray-400 transition-transform group-open:rotate-180">⌄</span>
              </summary>

              <div class="space-y-1 border-t border-gray-100 p-2">
                <% phase[:chapters].each do |chapter| %>
                  <%= render "product_content/sidebar_chapter_row", chapter: chapter, current_id: @current_id, theme_classes: theme_classes %>
                <% end %>
              </div>
            </details>
          <% end %>

          <% if @ungrouped_chapters.any? %>
            <div class="space-y-1 p-2">
              <% @ungrouped_chapters.each do |chapter| %>
                <%= render "product_content/sidebar_chapter_row", chapter: chapter, current_id: @current_id, theme_classes: theme_classes %>
              <% end %>
            </div>
          <% end %>

          <% if @appendix_chapters.any? %>
            <% appendix_open = @appendix_chapters.any? { |chapter| chapter[:id] == @current_id } %>
            <details class="group overflow-hidden rounded-xl border border-gray-200 bg-white" <%= "open" if appendix_open %>>
              <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 hover:bg-gray-50">
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-600">부록</p>
                  <p class="truncate text-sm font-medium text-gray-800">특별판</p>
                </div>

                <span class="text-xs text-gray-400 transition-transform group-open:rotate-180">⌄</span>
              </summary>

              <div class="space-y-1 border-t border-gray-100 p-2">
                <% @appendix_chapters.each do |chapter| %>
                  <%= render "product_content/sidebar_chapter_row", chapter: chapter, current_id: @current_id, theme_classes: theme_classes %>
                <% end %>
              </div>
            </details>
          <% end %>
        </nav>
      </div>
    </aside>

    <main class="min-w-0 flex-1 overflow-y-auto">
      <div class="max-w-3xl px-5 py-10 sm:px-7 sm:py-12">
        <%= link_to "← #{@theme[:back_link_label]}", product_content_index_path_for(@product_code), class: "mb-6 inline-block text-sm text-gray-500 #{theme_classes[:nav_hover]}" %>

        <div class="mb-8 border-b border-gray-100 pb-6">
          <p class="mb-2 text-sm font-semibold uppercase tracking-wide <%= theme_classes[:label] %>">Chapter <%= @current_chapter[:id] %></p>
          <h1 class="text-3xl font-bold text-gray-900"><%= @current_chapter[:title] %></h1>
          <p class="mt-3 text-sm text-gray-500">최종 업데이트: <%= l(@last_updated_at, format: :long, locale: :ko) %></p>
        </div>

        <div class="doc-content max-w-none">
          <%= sanitize(
            @content_html,
            tags: %w[
              h1 h2 h3 h4 h5 h6 p br hr ul ol li pre code blockquote strong em a img
              table thead tbody tr th td
            ],
            attributes: %w[href target rel src alt]
          ) %>
        </div>

        <% if user_signed_in? && @current_chapter[:kind] != :appendix %>
          <div class="mt-10 rounded-lg border border-gray-200 bg-gray-50 p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="font-semibold text-gray-900">학습 상태</h2>
                <p class="mt-1 text-sm text-gray-600">
                  <% if @chapter_progress&.completed? %>
                    이 챕터를 완료한 상태입니다.
                  <% else %>
                    완료한 챕터로 표시하면 대시보드 진도에 반영됩니다.
                  <% end %>
                </p>
              </div>

              <% if @chapter_progress&.completed? %>
                <%= button_to "완료 표시 취소",
                  chapter_progresses_path(chapter_id: @current_id, product_code: @product_code),
                  method: :delete,
                  class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 transition hover:border-gray-400 hover:bg-gray-100" %>
              <% else %>
                <%= button_to "이 챕터 완료",
                  chapter_progresses_path(chapter_id: @current_id, product_code: @product_code),
                  method: :post,
                  class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% same_kind_chapters = @chapters.select { |chapter| chapter[:kind] == @current_chapter[:kind] } %>
        <% current_index = same_kind_chapters.index { |chapter| chapter[:id] == @current_id } %>
        <% prev_chapter = same_kind_chapters[0...current_index].reverse.find { |chapter| chapter[:available] && chapter[:accessible] } %>
        <% next_chapter = same_kind_chapters[(current_index + 1)..].find { |chapter| chapter[:available] && chapter[:accessible] } %>
        <div class="mt-16 flex justify-between border-t border-gray-100 pt-8">
          <% if prev_chapter %>
            <%= link_to product_chapter_path_for(prev_chapter[:product_code], prev_chapter[:id]), class: "flex items-center gap-2 text-sm text-gray-500 #{theme_classes[:nav_hover]}" do %>
              <span>←</span>
              <span><%= prev_chapter[:title] %></span>
            <% end %>
          <% else %>
            <div></div>
          <% end %>

          <% if next_chapter %>
            <%= link_to product_chapter_path_for(next_chapter[:product_code], next_chapter[:id]), class: "flex items-center gap-2 text-sm text-gray-500 #{theme_classes[:nav_hover]}" do %>
              <span><%= next_chapter[:title] %></span>
              <span>→</span>
            <% end %>
          <% end %>
        </div>
      </div>
    </main>
  </div>
</div>
