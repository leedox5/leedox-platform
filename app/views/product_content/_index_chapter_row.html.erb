<% if chapter[:available] && chapter[:accessible] %>
  <%= link_to product_chapter_path_for(chapter[:product_code], chapter[:id]),
        class: "group block rounded-xl border border-gray-200 bg-white p-4 transition-all #{theme_classes[:link_hover_border]} hover:shadow-sm" do %>
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg text-sm font-bold <%= theme_classes[:icon_badge] %> <%= theme_classes[:icon_badge_hover] %>">
        <%= chapter[:id] %>
      </span>

      <span class="font-medium text-gray-900 <%= theme_classes[:link_hover_text] %>"><%= chapter[:title] %></span>

      <span class="ml-auto text-gray-300 <%= theme_classes[:link_hover_arrow] %>">→</span>
    </div>
  <% end %>
<% elsif chapter[:available] %>
  <div class="block cursor-not-allowed rounded-xl border border-gray-100 bg-gray-100 p-4 opacity-60">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gray-200 text-sm font-bold text-gray-400">
        🔒
      </span>

      <span class="font-medium text-gray-500"><%= chapter[:title] %></span>

      <span class="ml-auto text-xs text-gray-400">잠금</span>
    </div>
  </div>
<% else %>
  <div class="block cursor-not-allowed rounded-xl border border-gray-100 bg-gray-100 p-4 opacity-60">
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-gray-200 text-sm font-bold text-gray-400">
        <%= chapter[:id] %>
      </span>

      <span class="font-medium text-gray-500"><%= chapter[:title] %></span>

      <span class="ml-auto text-xs text-gray-400">공개 예정</span>
    </div>
  </div>
<% end %>
