<% episodes_array = @episodes.to_a %>
<% current_index = episodes_array.index(@current_episode) %>
<% prev_episode = current_index && current_index > 0 ? episodes_array[current_index - 1] : nil %>
<% next_episode = current_index ? episodes_array[current_index + 1] : nil %>

<div class="min-h-screen bg-white">
  <%= render "shared/header" %>
  <main class="mx-auto max-w-3xl px-5 py-10 sm:px-7">
    <%= link_to "← #{@bundle.customer_title.presence || @bundle.internal_name}", product_chapter_path(@product_code, @bundle.slug),
      class: "mb-3 inline-block text-sm text-gray-500 hover:text-blue-600" %>

    <div class="mb-8 border-b border-gray-100 pb-4">
      <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-blue-600">Chapter <%= @current_episode.display_id %></p>
      <h1 class="text-3xl font-bold text-gray-900"><%= @current_episode.customer_title.presence || "(제목 없음)" %></h1>
      <p class="mt-3 text-sm text-gray-500">최종 업데이트: <%= l(@last_updated_at, format: :long, locale: :ko) %></p>
    </div>

    <div class="doc-content max-w-none">
      <%= sanitize(
        @content_html,
        tags: %w[h1 h2 h3 h4 h5 h6 p br hr ul ol li pre code blockquote strong em a img table thead tbody tr th td input],
        attributes: %w[href target rel src alt type disabled checked style]
      ) %>
    </div>

    <% if @takeaways.present? %>
      <div class="mt-10 space-y-4">
        <% @takeaways.each do |takeaway| %>
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-5">
            <p class="text-xs font-bold uppercase tracking-wide text-amber-700"><%= takeaway[:kind] %></p>
            <div class="doc-content mt-2 max-w-none text-sm">
              <%= sanitize(
                takeaway[:body_html],
                tags: %w[h1 h2 h3 h4 h5 h6 p br hr ul ol li pre code blockquote strong em a img table thead tbody tr th td input],
                attributes: %w[href target rel src alt type disabled checked style]
              ) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mt-16 flex justify-between border-t border-gray-100 pt-8">
      <% if prev_episode %>
        <%= link_to product_bundle_episode_path(@product_code, @bundle.slug, prev_episode.display_id), class: "flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600" do %>
          <span>←</span>
          <span><%= prev_episode.customer_title.presence || "(제목 없음)" %></span>
        <% end %>
      <% else %>
        <div></div>
      <% end %>

      <% if next_episode %>
        <%= link_to product_bundle_episode_path(@product_code, @bundle.slug, next_episode.display_id), class: "flex items-center gap-2 text-sm text-gray-500 hover:text-blue-600" do %>
          <span><%= next_episode.customer_title.presence || "(제목 없음)" %></span>
          <span>→</span>
        <% end %>
      <% end %>
    </div>
  </main>
</div>
