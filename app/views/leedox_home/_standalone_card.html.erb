<%# Handoff 0071 (e) -- a standalone product (Chatdox, Claudox, aistart, Antigravity) in the home's AI row, in the
    same card shape as a series card. Name, one-line description, badge and price all come from the same data
    /pricing uses (Product#name / #tagline / #landing_page_path, StandaloneProductsHelper) -- nothing is typed
    in here. These products have no cover image on record, so the card uses the drawn placeholder. The whole
    card links to the product's own page; a product without a landing page is shown but not linked. %>
<% card_classes = "flex flex-col overflow-hidden rounded-xl border border-white/10 bg-[#15181e] transition hover:border-[#f0a53c]/60" %>
<% body = capture do %>
  <div aria-hidden="true" class="flex aspect-video w-full items-center justify-center bg-gradient-to-br from-[#1b1e25] via-[#161920] to-[#0e1014]">
    <span class="text-4xl font-black text-[#f0a53c]/40"><%= product.name.first %></span>
  </div>
  <div class="flex flex-1 flex-col p-4">
    <h3 class="break-keep font-bold text-[#f2efe8]"><%= product.name %></h3>
    <% if product.tagline.present? %>
      <p class="mt-1 break-keep text-sm leading-relaxed text-[#c9c4ba]"><%= product.tagline %></p>
    <% end %>
    <p class="mt-auto pt-4 text-xs text-[#a8a39a]">
      <%= standalone_product_badge(product) %> · <span class="font-semibold text-[#f0a53c]"><%= standalone_product_price(product) %></span>
    </p>
  </div>
<% end %>
<% if product.landing_page_path.present? %>
  <%= link_to body, product.landing_page_path, class: card_classes, data: { product_code: product.code } %>
<% else %>
  <div class="<%= card_classes %>" data-product-code="<%= product.code %>"><%= body %></div>
<% end %>
