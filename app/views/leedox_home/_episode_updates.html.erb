<%# Handoff 0071 (d) -- "새로 공개 · 공개 예정": up to 5 episodes of listed series (chosen in
    PagesController#load_episode_updates). A published card links to the episode (its gate is unchanged); a
    공개 예정 card is a <div>, never a link -- the same rule as the product page's 공개 예정 cards (0070).
    Nothing to show prints nothing. %>
<% if @episode_updates.any? %>
  <section aria-labelledby="episode-updates" class="mx-auto max-w-6xl px-5 py-12 sm:px-7">
    <h2 id="episode-updates" class="font-display text-2xl font-bold text-[#f2efe8]">새로 공개 · 공개 예정</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <% @episode_updates.each do |kind, episode| %>
        <% line = episode.product_line %>
        <% inner = capture do %>
          <div class="flex items-center justify-between gap-2">
            <span class="min-w-0 truncate font-mono text-xs text-[#a8a39a]"><%= line.customer_name %></span>
            <% if kind == :published %>
              <span class="shrink-0 rounded-full bg-[#f0a53c] px-2 py-0.5 text-xs font-bold text-[#0e1014]">공개</span>
            <% else %>
              <span class="shrink-0 rounded-full border border-white/25 px-2 py-0.5 text-xs font-bold text-[#c9c4ba]">공개 예정</span>
            <% end %>
          </div>
          <p class="mt-3 break-keep font-bold <%= kind == :published ? "text-[#f2efe8]" : "text-[#c9c4ba]" %>"><%= episode.customer_title %></p>
          <% if episode.summary.present? %>
            <p class="mt-1 break-keep text-sm text-[#a8a39a]"><%= episode.summary %></p>
          <% end %>
        <% end %>
        <li class="min-w-0">
          <% if kind == :published %>
            <%= link_to inner, product_episode_path(line.slug, episode.display_id),
              class: "block h-full rounded-xl border border-white/10 bg-[#15181e] p-4 transition hover:border-[#f0a53c]/60" %>
          <% else %>
            <div class="h-full rounded-xl border border-dashed border-white/15 p-4"><%= inner %></div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
