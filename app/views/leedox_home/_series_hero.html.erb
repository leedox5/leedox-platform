<%# Handoff 0096 -- the featured guide as one card under a section heading (was 0071's hero: small line, h1, summary,
    release line, two buttons and a side image). Rendered only when a guide is featured and listed (the page skips it
    otherwise). The whole card links to the guide page; the arrow is part of the card, not a second link, and the
    link reads as the guide's name. Badge: ProductLine#access_state with the /products card's label and colors (0068);
    "N편" counts published episodes only (공개 예정 when none). Phones: image on top, text below. lg and up: two
    columns inside the card (image 3 : text 2) -- Tommy kept it (R1).
    R2 -- the two columns start at md (768px; was lg) so a small laptop window or a tablet isn't one big image.
    md..lg has a narrow text column (~245-350px), so smaller values there: padding 20px, name 26px/34px, arrow 40px;
    lg and up as R1. Below md (sm included) the card stays stacked. %>
<% line = @featured_line %>
<% state = @series_access_states[line.id] %>
<section aria-labelledby="featured-guide-heading" class="mx-auto max-w-6xl px-2.5 pt-3.5 pb-[18px] sm:px-7 sm:pt-8 sm:pb-9">
  <h2 id="featured-guide-heading" class="font-display text-2xl font-bold text-[#f2efe8]">지금 시작하는 가이드</h2>
  <%= link_to product_line_path(line.slug), aria: { labelledby: "featured-guide-name" },
    class: "mt-3 block overflow-hidden rounded-2xl border border-white/10 bg-[#15181e] transition hover:border-[#f0a53c]/60 md:grid md:grid-cols-5 md:items-center" do %>
    <div class="md:col-span-3">
      <% if line.cover_image.attached? %>
        <%= render "product_lines/cover_image", product_line: line, variant: :hero,
          classes: "block aspect-video w-full max-w-full bg-white/5 object-cover" %>
      <% else %>
        <%= render "product_lines/cover_placeholder", product_line: line, dark: true %>
      <% end %>
    </div>
    <div class="px-3.5 pt-3 pb-3.5 md:col-span-2 md:p-5 lg:p-7">
      <% if state %>
        <span class="inline-block <%= product_list_state_classes(state) %>"><%= product_list_state_label(state, line) %></span>
      <% end %>
      <h3 id="featured-guide-name" class="mt-2 break-keep break-words font-display text-[22px] font-bold leading-[29px] text-[#f2efe8] md:text-[26px] md:leading-[34px] lg:mt-3 lg:text-[34px] lg:leading-[42px]"><%= line.customer_name %></h3>
      <div class="mt-3 flex items-center justify-between gap-3 md:mt-4 lg:mt-5">
        <span class="text-sm text-[#a8a39a]"><%= guide_episode_count_label(@published_counts.fetch(line.id, 0)) %></span>
        <span aria-hidden="true" class="flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-[#f0a53c] font-bold text-[#0e1014] md:h-10 md:w-10 lg:h-11 lg:w-11">→</span>
      </div>
    </div>
  <% end %>
</section>
