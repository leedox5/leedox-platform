<%# Handoff 0071 (b) -- the featured series. Rendered only when a featured series is listed (the page skips
    this partial entirely otherwise -- never an empty hero). Everything shown comes from existing judgments:
    price/owned from ProductLine#access_state (0068), published vs 공개 예정 from the product page's own split
    (0070). The season slot shows series_label when the admin has set one (the only season-like field on a
    ProductLine -- free text, e.g. "S01"), otherwise the fixed "S01". %>
<% line = @featured_line %>
<% state = @series_access_states[line.id] %>
<% total = @featured_published.size + @featured_upcoming.size %>
<section aria-labelledby="featured-series-title" class="border-b border-white/10">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-7 lg:grid-cols-2 lg:items-center lg:py-20">
    <div class="min-w-0">
      <p class="text-xs font-semibold tracking-wide text-[#f0a53c]">
        지금 시작하는 시리즈 · <%= line.series_label.presence || "S01" %> · <%= total %>편<% if state %> · <%= product_list_state_label(state, line) %><% end %>
      </p>
      <h1 id="featured-series-title" class="mt-4 break-keep text-4xl font-bold leading-tight text-[#f2efe8] sm:text-5xl"><%= line.customer_name %></h1>
      <% if line.summary.present? %>
        <p class="mt-5 max-w-xl break-keep text-lg leading-relaxed text-[#c9c4ba]"><%= line.summary %></p>
      <% end %>
      <p class="mt-5 text-sm text-[#a8a39a]"><%= series_release_label(@featured_published, @featured_upcoming) %></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <% if (first = @featured_published.first) %>
          <%= link_to "E#{first.display_id}부터 보기", product_episode_path(line.slug, first.display_id),
            class: "inline-flex items-center rounded-lg bg-[#f0a53c] px-5 py-3 text-sm font-bold text-[#0e1014] hover:bg-[#f5b85e]" %>
        <% end %>
        <%= link_to "시리즈 소개", product_line_path(line.slug),
          class: "inline-flex items-center rounded-lg border border-white/25 px-5 py-3 text-sm font-bold text-[#f2efe8] hover:border-white/50" %>
      </div>
    </div>
    <div class="min-w-0">
      <% if line.cover_image.attached? %>
        <%= render "product_lines/cover_image", product_line: line, variant: :hero %>
      <% else %>
        <%= render "product_lines/cover_placeholder", product_line: line, dark: true, classes: "rounded-2xl" %>
      <% end %>
    </div>
  </div>
</section>
