<%# Handoff 0071 (c) -- one row per track that has at least one listed series (a track with none prints
    nothing at all). Cards are ordered like /products (oldest first). 4 across on desktop; on smaller screens they
    stack (2 across, then 1) rather than scrolling sideways -- the same grid as /products, no hidden cards and
    nothing that needs a swipe to discover. %>
<% taglines = { "basics" => "개발환경부터 버전 관리까지, 손에 익히는 기초", "ai" => "AI를 팀원처럼, 도구처럼 — 실제로 만든 기록" } %>
<% @track_rows.each do |track, lines| %>
  <section aria-labelledby="track-<%= track %>" class="mx-auto max-w-6xl px-5 py-12 sm:px-7">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 id="track-<%= track %>" class="text-2xl font-bold text-[#f2efe8]"><%= ProductLine::TRACKS[track] %></h2>
      <p class="text-sm text-[#a8a39a]"><%= taglines[track] %></p>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% lines.each do |line| %>
        <%= render "leedox_home/series_card", line: line %>
      <% end %>
    </div>
  </section>
<% end %>
